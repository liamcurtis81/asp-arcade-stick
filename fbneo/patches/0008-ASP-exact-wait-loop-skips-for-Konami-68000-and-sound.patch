+// ASP idle loops (see asp_idle.h). Konami's task-queue wait:
+//   movea.l (queue head).l,a0 ; move.w (a0),d1 ; bmi top
+static INT32 asp_ssriders_again(void)
+{
+	UINT32 a = SekReadLong(0x104014);
+	return a >= 0x104000 && a <= 0x107ffe && (SekReadWord(a) & 0x8000);
+}
+static AspIdle68k asp_idle_ssriders = { 3, { 0x1578, 0x157e, 0x1580 }, { 20, 8, 10 },
+	{ 0x2079, 0x3210, 0x6bf6 }, asp_ssriders_again, 0 };
+static AspIdle68k asp_idle_tmnt22pu = { 3, { 0x1470, 0x1476, 0x1478 }, { 20, 8, 10 },
+	{ 0x2079, 0x3210, 0x6bf6 }, asp_ssriders_again, 0 };   // same queue head
+static AspIdle68k *asp_tmnt_idle = NULL;
+
+// ASP sound Z80 wait (see ZetSetIdleLoop), Sunset Riders 064e01.2f at 07f6,
+// TMNT2 063b01.2f at 0d17:  BIT 1,(HL=0xf801) ; JP Z,self  - YM2151 timer flag
+static INT32 asp_tmnt_zwait(void)
+{
+	return ZetHL(-1) == 0xf801 && !(BurnYM2151Read() & 2);
+}
