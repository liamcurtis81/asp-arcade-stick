 // Frame hashing: a correctness harness for touching the renderers.
 //
@@ -324,6 +327,18 @@ static int RunGetNextSound(int bDraw)
 	// Render frame with sound
 	pBurnSoundOut = nAudNextSound;
 	RunFrame(bDraw, 0);
+#ifdef BUILD_ASP
+	{	// Harness only (ASP_SNDHASH=path): running hash of every frame's sound,
+		// written every 500 frames, so a change can be proved not to alter it.
+		static unsigned int h = 2166136261u, fr = 0; static int on = -1;
+		if (on < 0) on = getenv("ASP_SNDHASH") != NULL;
+		if (on && nAudNextSound) {
+			const unsigned char *b = (const unsigned char *)nAudNextSound;
+			for (int j = 0; j < (nAudSegLen << 2); j++) h = (h ^ b[j]) * 16777619u;
+			if ((++fr % 500) == 0) { FILE *f = fopen(getenv("ASP_SNDHASH"), "a"); if (f) { fprintf(f, "%u:%08x\n", fr, h); fclose(f); } }
+		}
+	}
+#endif
 	if (bAppDoStep) {
 		memset(nAudNextSound, 0, nAudSegLen << 2);		// Write silence into the buffer
 	}
