+static INT32 DrvExit()
+{
+	GenericTilesExit();
+	deco16Exit();
+
+	if (use_bsmt)
+	{
+		use_bsmt = 0;
+		decobsmt_exit();
+	}
+	else if (use_z80)
+	{
+		use_z80 = 0;
+		deco32_z80_sound_exit();
+	}
+	else
+	{
+		deco16SoundExit();
+	}
+
+	if (game_select != 3) {
+		EEPROMExit();
+	}
+
+	ArmExit();
+
+	if (uses_gun) {
+		BurnGunExit();
+		uses_gun = 0;
+	}
+
+	BurnFreeMemIndex();
+
+	raster1_irq_cb = NULL;
+	raster2_irq_cb = NULL;
+	vblank_irq_cb = NULL;
+	lightgun_irq_cb = NULL;
+	has_ace = 0;
+	speedhack_address = 0;
+
+	pStartDraw = NULL;
+	pDrawScanline = NULL;
+
+	return 0;
+}
