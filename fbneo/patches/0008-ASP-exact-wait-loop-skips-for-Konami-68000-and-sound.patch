+static void TmntDecodeTitleSample()
+{
+	for (INT32 i = 0; i < 0x40000; i++) {
+		INT32 val = DrvTempRom[2 * i + 0] + (DrvTempRom[(2 * i) + 1] << 8);
+		INT32 expo = val >> 13;
+
+	  	val = (val >> 3) & (0x3ff);
+		val -= 0x200;
+
+		val <<= (expo-3);
+
+		DrvTitleSample[i] = val;
+	}
+}
