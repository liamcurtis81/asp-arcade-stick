+static INT32 DrvDoReset()
+{
+	memset (AllRam, 0, RamEnd - AllRam);
+
+	SekOpen(0);
+	SekReset();
+	SekClose();
+
+	ZetOpen(0);
+	ZetReset();
+	bankswitch(2);
+	ZetClose();
+
+	KonamiICReset();
+
+	BurnYM2151Reset();
+	K054539Reset(0);
+
+	EEPROMReset();
+
+	if (EEPROMAvailable() == 0) {
+		EEPROMFill(DrvEeprom, 0, 128);
+	}
+
+	control_data = 0;
+	irq5_timer = 0;
+
+	for (INT32 i = 0; i < 4; i++)
+	{
+		layer_colorbase[i] = 0;
+		layerpri[i] = 0;
+	}
+
+	sound_nmi_enable = 0;
+	z80_bank = 0;
+
+	nExtraCycles[0] = nExtraCycles[1] = 0;
+	
+	HiscoreReset();
+
+	return 0;
+}
