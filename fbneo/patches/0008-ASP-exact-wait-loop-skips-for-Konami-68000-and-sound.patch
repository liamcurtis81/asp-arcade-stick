+static void shuffle(UINT16 *buf, INT32 len)
+{
+	INT32 i;
+	UINT16 t;
+
+	if (len == 2) return;
+
+	if (len % 4) return;
+
+	len /= 2;
+
+	for (i = 0;i < len/2;i++) {
+		t = buf[len/2 + i];
+		buf[len/2 + i] = buf[len + i];
+		buf[len + i] = t;
+	}
+
+	shuffle(buf,len);
+	shuffle(buf + len,len);
+}
+
+static void byte_shuffle(UINT8 *buf, INT32 len)
+{
+	INT32 i;
+	UINT8 t;
+
+	if (len == 2) return;
+
+	if (len % 4) return;
+
+	len /= 2;
+
+	for (i = 0;i < len/2;i++) {
+		t = buf[len/2 + i];
+		buf[len/2 + i] = buf[len + i];
+		buf[len + i] = t;
+	}
+
+	byte_shuffle(buf,len);
+	byte_shuffle(buf + len,len);
+}
