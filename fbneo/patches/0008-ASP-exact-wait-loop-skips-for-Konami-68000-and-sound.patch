+static void TmntUnscrambleGfx(UINT8 *pSrc, INT32 nLength)
+{
+	INT32 bits[32];
+	for (INT32 i = 0; i < nLength; i += 4) {
+		for (INT32 j = 0; j < 4; j++) {
+			for (INT32 k = 0; k < 8; k++) {
+				bits[8*j + k] = (pSrc[i + j] >> k) & 1;
+			}
+		}
+
+		for (INT32 j = 0; j < 4; j++) {
+			pSrc[i + j] = 0;
+			for (INT32 k = 0; k < 8; k++) {
+				pSrc[i + j] |= bits[j + 4*k] << k;
+			}
+		}
+	}
+}
