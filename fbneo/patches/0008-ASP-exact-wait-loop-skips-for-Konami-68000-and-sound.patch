-		if (BurnLoadRom(DrvSndROM  + 0x000000, 11, 1)) return 1;
-
-		if (BurnLoadRom(DrvEEPROM  + 0x000000, 12, 1)) return 1;
-
-		K052109GfxDecode(DrvGfxROM0, DrvGfxROMExp0, 0x200000);
-		K053247GfxDecode(DrvGfxROM1, DrvGfxROMExp1, 0x400000);
