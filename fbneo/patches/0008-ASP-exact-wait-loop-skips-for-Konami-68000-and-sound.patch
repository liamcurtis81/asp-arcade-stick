+	if (nOpenedCPU == -1) bprintf(PRINT_ERROR, _T("ZetSetHALT called when no CPU open\n"));
+#endif
+
+	if (nOpenedCPU < 0) return;
+
+	ZetCPUContext[nOpenedCPU]->BusReq = nStatus;
+	if (nStatus) ZetRunEnd(); // end current timeslice since we're halted
+}
