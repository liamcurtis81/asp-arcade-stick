-static INT32 DrvDraw()
-{
-	if (DrvRecalc) {
-		DrvRecalcPalette();
-	}
-
-	if (nScreenWidth != 288) {
-		draw_side(1);
-	}
-	draw_side(0);
-
-	KonamiBlendCopy(DrvPalette);
-
-	return 0;
-}
