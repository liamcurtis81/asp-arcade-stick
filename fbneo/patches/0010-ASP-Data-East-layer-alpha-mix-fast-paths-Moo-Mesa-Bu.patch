@@ -395,31 +395,47 @@ static INT32 ZetRunReal(INT32 nCycles);
 // outside ZetRun), so inside one call the loop cannot end until the cycles do.
 extern int asp_idle_skips;
 extern unsigned long long asp_idle_skippedz80;
-static struct { UINT16 pc[2]; INT32 cyc[2]; INT32 (*again)(void); } asp_zidle[MAX_Z80];
-void ZetSetIdleLoop(INT32 nCPU, UINT16 pc0, INT32 cyc0, UINT16 pc1, INT32 cyc1, INT32 (*again)(void))
+static struct { INT32 n; UINT16 pc[6]; INT32 cyc[6]; INT32 (*again)(void); } asp_zidle[MAX_Z80];
+void ZetSetIdleLoopN(INT32 nCPU, INT32 n, const UINT16 *pcs, const INT32 *cycs, INT32 (*again)(void))
 {
-	asp_zidle[nCPU].pc[0] = pc0; asp_zidle[nCPU].cyc[0] = cyc0;
-	asp_zidle[nCPU].pc[1] = pc1; asp_zidle[nCPU].cyc[1] = cyc1;
+	if (n < 2 || n > 6) return;
+	asp_zidle[nCPU].n = n;
+	for (INT32 j = 0; j < n; j++) { asp_zidle[nCPU].pc[j] = pcs[j]; asp_zidle[nCPU].cyc[j] = cycs[j]; }
 	asp_zidle[nCPU].again = again;
 }
+void ZetSetIdleLoop(INT32 nCPU, UINT16 pc0, INT32 cyc0, UINT16 pc1, INT32 cyc1, INT32 (*again)(void))
+{
+	const UINT16 pcs[2] = { pc0, pc1 };
+	const INT32 cycs[2] = { cyc0, cyc1 };
+	ZetSetIdleLoopN(nCPU, 2, pcs, cycs, again);
+}
 #endif
 
 INT32 ZetRun(INT32 nCycles)
 {
 #ifdef BUILD_ASP
 	if (nCycles > 64 && asp_idle_skips && nOpenedCPU >= 0 && asp_zidle[nOpenedCPU].again) {
-		const UINT16 p0 = asp_zidle[nOpenedCPU].pc[0], p1 = asp_zidle[nOpenedCPU].pc[1];
-		const INT32 c0 = asp_zidle[nOpenedCPU].cyc[0], c1 = asp_zidle[nOpenedCPU].cyc[1];
-		const INT32 iter = c0 + c1;
+		const INT32 n = asp_zidle[nOpenedCPU].n;
+		const UINT16 *P = asp_zidle[nOpenedCPU].pc;
+		const INT32 *C = asp_zidle[nOpenedCPU].cyc;
+		INT32 iter = 0;
+		for (INT32 j = 0; j < n; j++) iter += C[j];
 		INT32 ran = ZetRunReal(1);          // takes any pending interrupt first
 		INT32 rem = nCycles - ran;
 		UINT32 pc = ZetGetPC(-1);
-		if (pc == p1 && rem > c1 && asp_zidle[nOpenedCPU].again()) {
-			INT32 r = ZetRunReal(c1);       // finish this pass for real: lands on p0
-			ran += r; rem -= r;
-			pc = ZetGetPC(-1);
+		for (INT32 j = 1; j < n; j++) {
+			if (pc == P[j]) {               // mid-pass: finish it for real, lands on P[0]
+				INT32 to_top = 0;
+				for (INT32 m = j; m < n; m++) to_top += C[m];
+				if (rem > to_top && asp_zidle[nOpenedCPU].again()) {
+					INT32 r = ZetRunReal(to_top);
+					ran += r; rem -= r;
+					pc = ZetGetPC(-1);
+				}
+				break;
+			}
 		}
-		if (pc == p0 && rem > iter && asp_zidle[nOpenedCPU].again()) {
+		if (pc == P[0] && rem > iter && asp_zidle[nOpenedCPU].again()) {
 			INT32 k = (rem - 1) / iter;
 			nZetCyclesTotal += k * iter;    // as ZetIdle
 			asp_idle_skippedz80 += k * iter;
