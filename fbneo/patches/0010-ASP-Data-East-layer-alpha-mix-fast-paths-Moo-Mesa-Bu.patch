diff --git a/src/burn/drv/konami/d_moo.cpp b/src/burn/drv/konami/d_moo.cpp
index 066481d..37fb3c3 100644
--- a/src/burn/drv/konami/d_moo.cpp
+++ b/src/burn/drv/konami/d_moo.cpp
@@ -29,6 +29,24 @@ static AspIdle68k asp_idle_bucky = { 3, { 0x14c2, 0x14c8, 0x14ca }, { 20, 8, 10
 	{ 0x2079, 0x3010, 0x6bf6 }, asp_bucky_again, 0 };
 static AspIdle68k *asp_moo_idle = NULL;
 
+// ASP sound Z80 wait (see ZetSetIdleLoopN): poll the YM2151 timer flag through
+// a subroutine:  CALL status ; LD A,($ec01) ; AND 2 ; RET ; JR Z,back
+static INT32 asp_moo_zwait(void)
+{
+	return !(BurnYM2151Read() & 2);
+}
+static const INT32 asp_moo_zcyc[5] = { 17, 13, 7, 10, 12 };
+static const UINT16 asp_moomesa_zpc[5] = { 0x00ae, 0x0c43, 0x0c46, 0x0c48, 0x00b1 };   // 151a07.f5
+static const UINT16 asp_bucky_zpc[5]   = { 0x00a8, 0x0bce, 0x0bd1, 0x0bd3, 0x00ab };   // 173a07.f5
+static void asp_moo_zset(const UINT16 *pc)
+{
+#ifdef BUILD_ASP
+	static const UINT8 want[5][2] = { { 0xcd, 0 }, { 0x3a, 0 }, { 0xe6, 0 }, { 0xc9, 0 }, { 0x28, 0 } };
+	for (INT32 j = 0; j < 5; j++) if (ZetReadByte(pc[j]) != want[j][0]) return;
+	ZetSetIdleLoopN(0, 5, pc, asp_moo_zcyc, asp_moo_zwait);
+#endif
+}
+
 static UINT8 *AllMem;
 static UINT8 *Drv68KROM;
 static UINT8 *DrvZ80ROM;
@@ -1036,6 +1054,7 @@ static INT32 MooInit()
 	ZetMapMemory(DrvZ80RAM,			0xc000, 0xdfff, MAP_RAM);
 	ZetSetWriteHandler(moo_sound_write);
 	ZetSetReadHandler(moo_sound_read);
+	asp_moo_zset(asp_moomesa_zpc);
 	ZetClose();
 
 	EEPROMInit(&moo_eeprom_interface);
@@ -1127,6 +1146,7 @@ static INT32 BuckyInit()
 	ZetMapMemory(DrvZ80RAM,			0xc000, 0xdfff, MAP_RAM);
 	ZetSetWriteHandler(moo_sound_write);
 	ZetSetReadHandler(moo_sound_read);
+	asp_moo_zset(asp_bucky_zpc);
 	ZetClose();
 
 	EEPROMInit(&moo_eeprom_interface);
