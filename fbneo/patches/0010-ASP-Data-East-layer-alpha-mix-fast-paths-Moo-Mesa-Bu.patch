diff --git a/src/burn/asp_dsplit.h b/src/burn/asp_dsplit.h
new file mode 100644
index 0000000..1733fa5
--- /dev/null
+++ b/src/burn/asp_dsplit.h
@@ -0,0 +1,22 @@
+// ASP: per-stage timing of a driver's draw, reported in the exit log as
+// "draw split". Usage: ASP_DS_BEGIN at the top of the draw, ASP_DS(k, "name")
+// after each stage. Compiles to nothing outside the stick build.
+#ifndef ASP_DSPLIT_H
+#define ASP_DSPLIT_H
+#ifdef BUILD_ASP
+#include <time.h>
+extern unsigned long long asp_ds_t[8];
+extern unsigned int asp_ds_frames;
+extern const char *asp_ds_name[8];
+static inline unsigned long long asp_ds_now(void)
+{
+	struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (unsigned long long)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+#define ASP_DS_BEGIN unsigned long long asp_ds_prev = asp_ds_now(); asp_ds_frames++
+#define ASP_DS(k, name) do { unsigned long long n_ = asp_ds_now(); asp_ds_t[k] += n_ - asp_ds_prev; asp_ds_prev = n_; asp_ds_name[k] = name; } while (0)
+#else
+#define ASP_DS_BEGIN do {} while (0)
+#define ASP_DS(k, name) do {} while (0)
+#endif
+#endif
