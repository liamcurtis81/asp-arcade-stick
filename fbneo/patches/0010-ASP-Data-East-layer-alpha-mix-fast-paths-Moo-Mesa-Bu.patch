 			UINT16 priColAlphaPal0=sprite0[x];
 			UINT16 priColAlphaPal1=sprite1[x];
+#ifdef BUILD_ASP
+			// ASP: no sprite pixel in either buffer and no alpha-tilemap pixel:
+			// every branch below is skipped, so skip the work of reaching them.
+			if (!(priColAlphaPal0 & 0xff) && !(priColAlphaPal1 & 0xff) &&
+				!(mixAlphaTilemap && drawAlphaTilemap && (alphaTilemap[x] & 0xf)))
+				continue;
+#endif
 			UINT16 pri0=(priColAlphaPal0&0x6000)>>13;
 			UINT16 pri1=(priColAlphaPal1&0x6000)>>13;
 			UINT16 col0=((priColAlphaPal0&0x1f00)>>8);
