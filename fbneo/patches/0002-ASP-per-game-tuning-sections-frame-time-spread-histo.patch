 #include <unistd.h>
 
 TCHAR* AdaptiveEncodingReads(const TCHAR* pszFileName)
@@ -300,6 +301,89 @@ extern int asp_draw_lead;
 extern int asp_aud_rate_override;
 extern int asp_aud_device_samples;
 extern int asp_hash_frames;
+extern int asp_exit_after_frames;
+
+// Returns 1 if the key was recognised and applied, 0 if it is unknown.
+static int asp_tuning_apply(const char *key, int value)
+{
+	if (strcmp(key, "always_draw_frames") == 0) {
+		bAlwaysDrawFrames = value;
+	} else if (strcmp(key, "draw_every_n") == 0) {
+		asp_draw_every_n = value;
+	} else if (strcmp(key, "draw_guard") == 0) {
+		asp_draw_guard = value;      // accepted, no longer consulted
+	} else if (strcmp(key, "profile_present") == 0) {
+		asp_fb_profile = value;
+	} else if (strcmp(key, "audio_segments") == 0) {
+		asp_aud_segments = value;
+	} else if (strcmp(key, "draw_lead") == 0) {
+		asp_draw_lead = value;
+	} else if (strcmp(key, "audio_rate") == 0) {
+		asp_aud_rate_override = value;
+	} else if (strcmp(key, "device_samples") == 0) {
+		asp_aud_device_samples = value;
+	} else if (strcmp(key, "hash_frames") == 0) {
+		asp_hash_frames = value;
+	} else if (strcmp(key, "exit_after_frames") == 0) {
+		asp_exit_after_frames = value;
+	} else {
+		return 0;
+	}
+	return 1;
+}
+
+// One sweep of the tuning file. want_section NULL reads only the keys that sit
+// before any [section] header, i.e. the globals; otherwise it reads only the
+// keys inside the section whose name matches, and ignores the globals.
+//
+// Two sweeps rather than one running parse, so the result does not depend on
+// where in the file a section happens to sit: globals always land first and a
+// per-game section always has the last word, even if someone puts the section
+// at the top.
+static void asp_tuning_pass(FILE *f, const char *want_section)
+{
+	char line[256];
+	char section[64] = "";               // empty means global scope
+
+	rewind(f);
+	while (fgets(line, sizeof(line), f)) {
+		char *p = line;
+		while (*p == ' ' || *p == '\t') p++;
+		if (*p == '#' || *p == '\n' || *p == '\r' || *p == '\0') continue;
+
+		if (*p == '[') {
+			char *end = strchr(p, ']');
+			if (!end) {
+				fprintf(stderr, "asp: tuning: unterminated section \"%s\", "
+					"ignored\n", p);
+				continue;
+			}
+			size_t n = (size_t)(end - (p + 1));
+			if (n >= sizeof(section)) n = sizeof(section) - 1;
+			memcpy(section, p + 1, n);
+			section[n] = '\0';
+			continue;
+		}
+
+		char key[64];
+		int value;
+		if (sscanf(p, "%63s %d", key, &value) != 2) continue;
+
+		int is_global = (section[0] == '\0');
+		if (want_section == NULL) {
+			if (!is_global) continue;
+		} else {
+			if (is_global || strcasecmp(section, want_section) != 0) continue;
+		}
+
+		if (asp_tuning_apply(key, value)) {
+			fprintf(stderr, "asp: tuning: %s%s = %d\n",
+				want_section ? "per-game " : "", key, value);
+		} else {
+			fprintf(stderr, "asp: tuning: unknown key \"%s\", ignored\n", key);
+		}
+	}
+}
 
 static void asp_tuning_load(void)
 {
@@ -315,37 +399,14 @@ static void asp_tuning_load(void)
 		return;
 	}
 
-	char line[256];
