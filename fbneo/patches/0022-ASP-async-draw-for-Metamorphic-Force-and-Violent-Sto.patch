+#ifdef BUILD_ASP
+// Async draw: the render thread gets its own mixing scratch (z-buffers and the
+// object pool), its own pointer to K054338's shadow table, and the sprite list
+// it should read. The register caches above are refilled by the mixer itself
+// (konamigx_precache_registers) from the K053247/K055555 copies bound for it.
+static UINT16 *konamigx_snap_spriteram = NULL;
+void KonamiGXAspCapture()
+{
+	if (m_gx_objdma && gx_spriteram) {
+		if (!konamigx_snap_spriteram) konamigx_snap_spriteram = (UINT16*)BurnMalloc(0x1000);
+		memcpy(konamigx_snap_spriteram, gx_spriteram, 0x1000);
+	}
+}
+void KonamiGXAspBind()
+{
+	if (!gx_shdzbuf) gx_shdzbuf = (UINT8*)calloc(1, 512 * 256 * 2);
+	if (!gx_objzbuf) gx_objzbuf = (UINT8*)calloc(1, 512 * 256 * 2);
+	if (!gx_objpool) gx_objpool = (struct GX_OBJ*)calloc(GX_MAX_OBJECTS, sizeof(GX_OBJ));
+	K054338_export_config(&K054338_shdRGB);   // this thread's m_shd_rgb
+	gx_spriteram = m_gx_objdma ? konamigx_snap_spriteram : (UINT16*)K053247Ram;
+}
+#endif
