+#ifdef BUILD_ASP
+// ASP: picture drawn on a second core for Mystic Warriors, Metamorphic Force
+// and Violent Storm (nGame 1-3), as Xexex. The draw reads palette RAM, one
+// work-RAM byte (Mystic Warriors' superblend scene id at 0x2335) and the GX
+// mixer's chips: K056832, K053247, K053250 (Metamorphic Force, Violent
+// Storm), K054338, K055555. The superblend counters live in the render
+// thread's own copies, which carry over from picture to picture as they did
+// on one thread. Martial Champion, Gaiapolis and Monster Maulers (K053936
+// roz) keep drawing inline.
+extern int asp_async_draw(void (*capture)(void), void (*bind)(void), INT32 (*draw)(void), INT32 height);
+extern void asp_async_stop();
+static UINT8 asp_mw_palram[0x2000];
+static UINT8 asp_mw_ram[0x10000];
+static UINT32 *asp_mw_palette = NULL;
+
+static void asp_mw_capture()
+{
+	memcpy(asp_mw_palram, DrvPalRAM, sizeof(asp_mw_palram));
+	asp_mw_ram[0x2335] = Drv68KRAM[0x2335];
+	K056832AspCapture(); K053247AspCapture(); K054338AspCapture(); K055555AspCapture();
+	if (nGame == 2 || nGame == 3) K053250AspCapture();
+	KonamiGXAspCapture();
+}
+
+static void asp_mw_bind()
+{
+	if (asp_mw_palette == NULL) asp_mw_palette = (UINT32*)calloc(0x0800, sizeof(UINT32));
+	DrvPalRAM = asp_mw_palram;
+	Drv68KRAM = asp_mw_ram;
+	DrvPalette = konami_palette32 = asp_mw_palette;
+	K056832AspBind(); K053247AspBind(); K054338AspBind(); K055555AspBind();
+	if (nGame == 2 || nGame == 3) K053250AspBind();
+	KonamiAspBindBitmaps();
+	KonamiGXAspBind();
+}
+
+static void asp_mw_draw_or_async()
+{
+	// Mystic Warriors (nGame 1) stays inline: on the render thread it draws a
+	// line of stray sprite pixels the inline draw does not (harness, frame 50,
+	// 81 pixels), cause not yet found. Metamorphic Force and Violent Storm are
+	// identical at all ten checkpoints.
+	if ((nGame == 2 || nGame == 3) && asp_async_draw(asp_mw_capture, asp_mw_bind, DrvDraw, nScreenHeight)) return;
+	DrvDraw();
+}
+#define ASP_MW_DRAW() asp_mw_draw_or_async()
+#else
+#define ASP_MW_DRAW() DrvDraw()
+#endif
+
 static INT32 DrvFrame()
 {
 #ifdef BUILD_ASP
@@ -3185,7 +3239,7 @@ static INT32 DrvFrame()
 
 				if (pBurnDraw && nGame == 2) { // metamrph only
 					// draw here to fix flickery and missing text in service mode
-					DrvDraw();
+					ASP_MW_DRAW();
 					drawn = 1;
 				}
 			}
@@ -3273,7 +3327,7 @@ static INT32 DrvFrame()
 
 	if (!drawn) {
 		if (pBurnDraw) {
-			DrvDraw();
+			ASP_MW_DRAW();
 		}
 	}
 
