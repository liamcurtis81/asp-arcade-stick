 }
 
+// ---------------------------------------------------------------------------
+// Present on a second core.
+//
+// The stick has four Cortex-A7 cores and the emulator ran on one. Every drawn
+// frame then paid about 2.7 ms on the emulation thread to scale the finished
+// picture and write it to the framebuffer - work that depends on no game state
+// at all. While it ran, no frame was emulated and so no sound was produced,
+// which is part of why sound arrives in bursts and the ring has to be deep.
+//
+// With present_thread 1 the emulation thread only copies the finished frame
+// into a hand-off buffer (288x224x2 = 129 KB for most boards) and returns. A
+// worker on another core does the scaling and the framebuffer write. If a new
+// frame is handed off before the worker has shown the previous one, the newest
+// simply replaces it: the emulator never waits on the screen.
+//
+// EVERY present goes through the worker while it runs, including pause and
+// redraw. asp_fb_present keeps static scratch buffers, so two threads presenting
+// at once would corrupt each other.
+//
+// Frame hashes are taken over pVidImage on the emulation thread, upstream of
+// all this, so they are unaffected by construction.
+// ---------------------------------------------------------------------------
+int asp_present_thread = 0;          // set from asp_tuning.txt
+
+static pthread_t       asp_pt;
+static pthread_mutex_t asp_pt_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  asp_pt_cond = PTHREAD_COND_INITIALIZER;
+static unsigned char  *asp_pt_pending = NULL;  // filled by the emulation thread
+static unsigned char  *asp_pt_work    = NULL;  // owned by the worker
+static size_t          asp_pt_size    = 0;
+static int             asp_pt_have    = 0;     // pending holds an unshown frame
+static int             asp_pt_stop    = 0;
+static int             asp_pt_running = 0;
+int asp_present_thread_live = 0;     // read by the exit report in run_pi
+
+static void *asp_present_worker(void *)
+{
+	for (;;) {
+		pthread_mutex_lock(&asp_pt_lock);
+		while (!asp_pt_have && !asp_pt_stop)
+			pthread_cond_wait(&asp_pt_cond, &asp_pt_lock);
+		if (asp_pt_stop) {
+			pthread_mutex_unlock(&asp_pt_lock);
+			break;
+		}
+		// Swap rather than copy under the lock, so the emulation thread is
+		// never held up for longer than a pointer exchange.
+		unsigned char *t = asp_pt_work;
+		asp_pt_work = asp_pt_pending;
+		asp_pt_pending = t;
+		asp_pt_have = 0;
+		pthread_mutex_unlock(&asp_pt_lock);
+
+		asp_present_from(asp_pt_work);
+	}
+	return NULL;
+}
+
+static void asp_present_thread_start()
+{
+	if (!asp_present_thread || asp_pt_running || !asp_buffer) return;
+
+	asp_pt_size    = (size_t)asp_buf_w * asp_buf_h * 2;
+	asp_pt_pending = (unsigned char *)malloc(asp_pt_size);
+	asp_pt_work    = (unsigned char *)malloc(asp_pt_size);
+	if (!asp_pt_pending || !asp_pt_work) {
+		free(asp_pt_pending); free(asp_pt_work);
+		asp_pt_pending = asp_pt_work = NULL;
+		fprintf(stderr, "asp: present thread: allocation failed, presenting inline\n");
+		return;
+	}
+	asp_pt_have = 0;
+	asp_pt_stop = 0;
+	if (pthread_create(&asp_pt, NULL, asp_present_worker, NULL) != 0) {
+		free(asp_pt_pending); free(asp_pt_work);
+		asp_pt_pending = asp_pt_work = NULL;
+		fprintf(stderr, "asp: present thread: could not start, presenting inline\n");
+		return;
+	}
+	asp_pt_running = 1;
+	asp_present_thread_live = 1;
+	fprintf(stderr, "asp: present thread running, %u-byte hand-off\n",
+		(unsigned)asp_pt_size);
+}
+
+static void asp_present_thread_stop()
+{
+	if (!asp_pt_running) return;
+	pthread_mutex_lock(&asp_pt_lock);
+	asp_pt_stop = 1;
+	pthread_cond_signal(&asp_pt_cond);
+	pthread_mutex_unlock(&asp_pt_lock);
+	pthread_join(asp_pt, NULL);
+	asp_pt_running = 0;
+	free(asp_pt_pending); free(asp_pt_work);
+	asp_pt_pending = asp_pt_work = NULL;
+}
+
+static void asp_present()
+{
+	if (!asp_buffer) return;
+	if (!asp_pt_running) {
+		asp_present_from(asp_buffer);
+		return;
+	}
+	pthread_mutex_lock(&asp_pt_lock);
+	memcpy(asp_pt_pending, asp_buffer, asp_pt_size);
+	asp_pt_have = 1;
+	pthread_cond_signal(&asp_pt_cond);
+	pthread_mutex_unlock(&asp_pt_lock);
+}
+
