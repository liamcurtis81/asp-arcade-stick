+	asp_present_thread_stop();
+
 	free(asp_buffer);
 	asp_buffer = (unsigned char *)calloc(1, (size_t)asp_buf_w * asp_buf_h * nVidImageBPP);
 	if (!asp_buffer) {
@@ -165,6 +282,9 @@ static int AspInit()
 	if (asp_fb_first_frame_setup())
 		asp_fb_bench();
 
+	// After the bench, so the measurement is not shared with a running worker.
+	asp_present_thread_start();
+
 	fprintf(stderr, "asp: game %dx%d aspect %d:%d%s%s -> buffer %dx%d RGB565\n",
 		gw, gh, xa, ya,
 		asp_rotated ? " rotated" : "", asp_flipped ? " flipped" : "",
@@ -175,6 +295,8 @@ static int AspInit()
 
 static int AspExit()
 {
+	// Stop the worker before the framebuffer it writes to goes away.
+	asp_present_thread_stop();
 	asp_fb_close();
 	free(asp_buffer);
 	asp_buffer = NULL;
