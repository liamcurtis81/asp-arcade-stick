 #define ASP_MAN_SYS "arcade"
 #define ASP_MAN_BASENAME
 #include "asp_manual.h"
+#include "asp_cheats.h"
+
+// ---------------------------------------------------------------------------
+// Cheats: hold Select + Down (pad: Select or minus + Down) for a second. The
+// list is FinalBurn Neo's own (cheats/arcade/<romset>.ini, or the game's
+// entries from cheat.dat), loaded by the core; what is switched on is kept
+// in <romset>.on beside them and set again at the next start.
+// ---------------------------------------------------------------------------
+extern int nExitEmulator;
+int asp_cheats_wanted = 0;
+static int asp_cheats_built;
+
+static int asp_cheats_emulator_apply(void)
+{
+	int n = 0;
+	for (int i = 0; i < cht_n; i++) {
+		int o = 0;
+		if (cht_usable(i) && cht[i].on) o = cht[i].nopt > 2 ? cht[i].opt : 1;
+		CheatEnable(i, o ? o : -1);
+		if (o) n++;
+	}
+	return n;
+}
+
+static void asp_cheats_build(void)
+{
+	char line[400];
+	int i = 0;
+	asp_cheats_built = 1;
+	for (CheatInfo *c = pCheatInfo; c && i < CHT_MAX; c = c->pNext, i++) {
+		int k;
+		cht[i].desc = strdup(c->szCheatName);
+		for (k = 0; k < CHEAT_MAX_OPTIONS && c->pOption[k]; k++) ;
+		cht[i].nopt = k;
+		cht[i].optname = (char **)calloc(k + 1, sizeof(char *));
+		for (int j = 0; j < k; j++) cht[i].optname[j] = strdup(c->pOption[j]->szOptionName);
+		cht[i].code = strdup(k >= 2 ? "fbneo" : "");    // a heading or a note: not selectable
+	}
+	cht_n = i;
+	if (cht_n == 0) return;
+	snprintf(cht_path, sizeof(cht_path), "%s%s.on", szAppCheatsPath, BurnDrvGetTextA(DRV_NAME));
+	FILE *f = fopen(cht_path, "r");
+	if (f) {
+		while (fgets(line, sizeof(line), f)) {
+			int n; char key[16], *p = strchr(line, '=');
+			if (!p || sscanf(line, "cheat%d_%15[a-z]", &n, key) != 2 || n < 0 || n >= cht_n) continue;
+			p = cht_value(p);
+			if (!strcmp(key, "enable")) cht[n].on = !strncmp(p, "true", 4);
+			else if (!strcmp(key, "option")) cht[n].opt = atoi(p);
+		}
+		fclose(f);
+		for (i = 0; i < cht_n; i++)
+			if (cht[i].opt >= cht[i].nopt || !cht_usable(i)) { cht[i].opt = 0; cht[i].on = 0; }
+	}
+	fprintf(stderr, "asp: %d cheats for %s\n", cht_n, BurnDrvGetTextA(DRV_NAME));
+}
+
+// Once a frame from the main loop: build the list the first time and set
+// again whatever was left on.
+void AspCheatsFrame()
+{
+	if (!asp_cheats_built) {
+		asp_cheats_build();
+		for (int i = 0; i < cht_n; i++) if (cht[i].on) { cheats_apply(); break; }
+	}
+}
+
+void AspCheatsOpen()
+{
+	asp_cheats_wanted = 0;
+	if (cht_n == 0) return;
+	if (joy == NULL && SDL_NumJoysticks() > 0) {
+		joy = SDL_JoystickOpen(0);
+		pad_mode = joy && SDL_JoystickNumButtons(joy) == 16;
+	}
+	int had_thread = asp_pt_running;
+	asp_present_thread_stop();
+	SDL_Delay(30);
+	AudSoundStop();
+	cheats_show();
+	AudSoundPlay();
+	if (had_thread) asp_present_thread_start();
+	if (quit_now) nExitEmulator = 1;
+}
 
 static void AspManualSetup()
