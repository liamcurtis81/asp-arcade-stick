+			case 0x2: bad = (op & 0x0f) <= 6; break;
+			case 0x4: switch (op & 0xff) { case 0x02: case 0x03: case 0x12: case 0x13: case 0x22: case 0x23: case 0x0b: case 0x1b: case 0x2b: bad = 1; } break; // sts.l/stc.l @-rn, jsr, tas.b, jmp
+			case 0x8:
