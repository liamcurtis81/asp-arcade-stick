+		switch (op >> 12) {
+			case 0x0: bad = ((op & 0x0f) >= 3 && (op & 0x0f) <= 6) || (op & 0xff) == 0x0b || (op & 0xff) == 0x1b || (op & 0xff) == 0x2b; break; // stores, bsrf, braf, rts, sleep, rte
