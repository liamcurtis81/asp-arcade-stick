+	INT32 di = l->icount - sh2->sh2_icount;
+	UINT32 dt = sh2->sh2_total_cycles - l->total;
+	INT32 k = (sh2->sh2_icount - 1) / di - 1;
+	UINT32 now = sh2_GetTotalCycles();
