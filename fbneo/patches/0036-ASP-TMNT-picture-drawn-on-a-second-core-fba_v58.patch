 void K052109UpdateScroll();
 void K052109AdjustScroll(INT32 x, INT32 y);
@@ -479,6 +479,7 @@ void K054338AspCapture(); void K054338AspBind();
 void K053251AspCapture(); void K053251AspBind();
 void K053245AspCapture(); void K053245AspBind();
 void K052109AspCapture(); void K052109AspBind();
