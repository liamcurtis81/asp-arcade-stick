+#ifdef BUILD_ASP
+// ASP: Night Slashers' picture drawn on a second core (burner/pi/asp_async.cpp).
+// Everything NslasherDraw reads that the emulation can change between pictures
+// is copied here at the moment the inline draw would have run; the render
+// thread's per-thread pointers (ASP_TLS) then point at the copies.
+extern int asp_async_draw(void (*capture)(void), void (*bind)(void), INT32 (*draw)(void), INT32 height);
+extern void asp_async_stop();
+static UINT8  asp_snap_pf[4][0x2000], asp_snap_rs[4][0x2000];
+static UINT16 asp_snap_ctl[2][8];
+static UINT8  asp_snap_pal[0x2000], asp_snap_ace[0x400], asp_snap_spr[0x2000], asp_snap_spr2[0x1000];
+static INT32  asp_snap_prio;
+static void asp_ns_capture(void)
+{
+	for (INT32 i = 0; i < 4; i++) {
+		memcpy(asp_snap_pf[i], deco16_pf_ram[i], 0x2000);
+		memcpy(asp_snap_rs[i], deco16_pf_rowscroll[i], 0x2000);
+	}
+	memcpy(asp_snap_ctl[0], deco16_pf_control[0], 0x10);
+	memcpy(asp_snap_ctl[1], deco16_pf_control[1], 0x10);
+	memcpy(asp_snap_pal, DrvPalBuf, 0x2000);
+	memcpy(asp_snap_ace, DrvAceRAM, 0x400);
+	memcpy(asp_snap_spr, DrvSprBuf, 0x2000);
+	memcpy(asp_snap_spr2, DrvSprBuf2, 0x1000);
+	asp_snap_prio = global_priority;
+}
+static void asp_ns_bind(void)     // runs on the render thread
+{
+	for (INT32 i = 0; i < 4; i++) {
+		deco16_pf_ram[i] = asp_snap_pf[i];
+		deco16_pf_rowscroll[i] = asp_snap_rs[i];
+	}
+	deco16_pf_control[0] = asp_snap_ctl[0];
+	deco16_pf_control[1] = asp_snap_ctl[1];
+	DrvPalBuf = asp_snap_pal;
+	DrvAceRAM = asp_snap_ace;
+	DrvSprBuf = asp_snap_spr;
+	DrvSprBuf2 = asp_snap_spr2;
+	global_priority = asp_snap_prio;
+}
+#endif
+
 static INT32 DrvFrame()
 {
 	if (DrvReset) {
@@ -3682,6 +3729,9 @@ static INT32 DrvFrame()
 	nExtraCycles[1] = nCyclesDone[1] - nCyclesTotal[1];
 
