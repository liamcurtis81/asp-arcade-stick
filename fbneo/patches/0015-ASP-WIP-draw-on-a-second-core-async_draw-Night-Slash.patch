+// Set by burner/pi/asp_async.cpp when the render thread owns this frame's
+// picture and will present it itself.
+int asp_async_frame_pending = 0;
+
+void asp_present_external(const unsigned char *buf)
+{
+	if (!buf || !asp_buffer) return;
+	if (!asp_pt_running) {
+		asp_present_from(buf);
+		return;
+	}
+	pthread_mutex_lock(&asp_pt_lock);
+	memcpy(asp_pt_pending, buf, asp_pt_size);
+	asp_pt_have = 1;
+	pthread_cond_signal(&asp_pt_cond);
+	pthread_mutex_unlock(&asp_pt_lock);
+}
+
 static int AspPaint(int /*bValidate*/)
 {
+	if (asp_async_frame_pending) {
+		asp_async_frame_pending = 0;
+		return 0;
+	}
 	asp_present();
 	return 0;
 }
