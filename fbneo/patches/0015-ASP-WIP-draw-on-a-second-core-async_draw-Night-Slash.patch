diff --git a/src/burner/pi/asp_async.cpp b/src/burner/pi/asp_async.cpp
new file mode 100644
index 0000000..65719e4
--- /dev/null
+++ b/src/burner/pi/asp_async.cpp
@@ -0,0 +1,123 @@
+// ASP: draw on a second core.
+//
+// The emulator ran on one core: emulate a frame, stop, draw the picture, carry
+// on. Sound is only made while emulating, so the sound buffer had to be deep
+// enough to cover every drawing pause - about 13 ms a picture on Night
+// Slashers - and that depth is the lag between picture and sound.
+//
+// A driver that opts in hands the picture to a render thread instead. At the
+// moment it would have drawn, it copies the video state the draw reads (tile
+// RAM, scroll registers, palette, sprite list) into a snapshot - a few tens of
+// KB, well under a millisecond - and returns to emulating. The render thread
+// points its own per-thread copies of the driver's video pointers (ASP_TLS)
+// at the snapshot, runs the driver's unchanged draw function into its own
+// buffer, and hands the finished picture to the present worker. The picture
+// is exactly the one the inline draw would have made, from exactly the same
+// state; it just reaches the screen while the next frame is being emulated.
+//
+// async_draw 0  off: draw inline, as before
+// async_draw 1  on
+// async_draw 2  check: use the render thread and snapshot, but wait for it and
+//               put the picture where the inline draw would, so the harness's
+//               frame hashes prove the snapshot is complete
+#include "burner.h"
+#include <pthread.h>
+#include <string.h>
+
+int asp_async_mode = 0;                 // asp_tuning.txt "async_draw"
+int asp_async_live = 0;                 // exit report
+unsigned int asp_async_frames = 0, asp_async_waits = 0;
+
+extern int asp_async_frame_pending;     // vid_asp.cpp: skip its own present
+extern void asp_present_external(const unsigned char *buf);
+
+static pthread_t       th;
+static pthread_mutex_t m = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  c_req = PTHREAD_COND_INITIALIZER, c_done = PTHREAD_COND_INITIALIZER;
+static int busy = 0, stop_req = 0, running = 0, present_it = 1;
+static void (*g_bind)(void) = NULL;
+static INT32 (*g_draw)(void) = NULL;
+static unsigned char *rbuf = NULL;
+static size_t rsize = 0;
+static INT32 rpitch = 0, rbpp = 0;
+
+static void *worker(void *)
+{
+	for (;;) {
+		pthread_mutex_lock(&m);
+		while (!busy && !stop_req) pthread_cond_wait(&c_req, &m);
+		if (stop_req) { pthread_mutex_unlock(&m); break; }
+		pthread_mutex_unlock(&m);
+
+		g_bind();
+		pBurnDraw  = rbuf;
+		nBurnPitch = rpitch;
+		nBurnBpp   = rbpp;
+		g_draw();
+		pBurnDraw = NULL;
+		if (present_it) asp_present_external(rbuf);
+
+		pthread_mutex_lock(&m);
+		busy = 0;
+		pthread_cond_broadcast(&c_done);
+		pthread_mutex_unlock(&m);
+	}
+	return NULL;
+}
+
+void asp_async_stop()
+{
+	if (!running) return;
+	pthread_mutex_lock(&m);
+	while (busy) pthread_cond_wait(&c_done, &m);
+	stop_req = 1;
+	pthread_cond_signal(&c_req);
+	pthread_mutex_unlock(&m);
+	pthread_join(th, NULL);
+	running = 0; stop_req = 0;
+	free(rbuf); rbuf = NULL; rsize = 0;
+	asp_async_live = 0;
+}
+
+// Called by a driver where it would draw. Returns 0 if it should draw inline.
+int asp_async_draw(void (*capture)(void), void (*bind)(void), INT32 (*draw)(void), INT32 height)
+{
+	if (!asp_async_mode || !pBurnDraw || nBurnPitch <= 0 || height <= 0) return 0;
+
+	size_t need = (size_t)nBurnPitch * height;
+	if (!running || need != rsize) {
+		asp_async_stop();
+		rbuf = (unsigned char *)malloc(need);
+		if (!rbuf) return 0;
+		rsize = need;
+		busy = 0; stop_req = 0;
+		if (pthread_create(&th, NULL, worker, NULL) != 0) { free(rbuf); rbuf = NULL; rsize = 0; return 0; }
+		running = 1;
+		asp_async_live = 1;
+	}
+
+	// The previous picture must be finished before its snapshot is reused.
+	pthread_mutex_lock(&m);
+	if (busy) asp_async_waits++;
+	while (busy) pthread_cond_wait(&c_done, &m);
+	pthread_mutex_unlock(&m);
+
+	capture();
+	g_bind = bind; g_draw = draw;
+	rpitch = nBurnPitch; rbpp = nBurnBpp;
+	present_it = (asp_async_mode == 1);
+	asp_async_frames++;
+
+	pthread_mutex_lock(&m);
+	busy = 1;
+	pthread_cond_signal(&c_req);
+	if (asp_async_mode == 2) {
+		while (busy) pthread_cond_wait(&c_done, &m);
+		pthread_mutex_unlock(&m);
+		memcpy(pBurnDraw, rbuf, rsize);     // inline-equivalent: normal present and hash
+		return 1;
+	}
+	pthread_mutex_unlock(&m);
+	asp_async_frame_pending = 1;
+	return 1;
+}
