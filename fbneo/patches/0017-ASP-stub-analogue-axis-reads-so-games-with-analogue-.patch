-#ifdef BUILD_ASP
-// ---------------------------------------------------------------------------
-// Reading the stick's directions straight from the kernel.
-//
-// The twelve buttons arrive as a joystick, which SDL reads happily. The four
-// directions do not: they arrive as arrow KEY events, and SDL 1.2 only starts
-// reading the console keyboard once a video mode has been set, because fbcon
-// opens it inside SDL_SetVideoMode rather than SDL_Init. This build draws
-// straight to /dev/fb0 and sets no mode, so SDL never saw them.
-//
-// Setting a mode just to wake that path was the obvious fix and it was wrong:
-// this display driver does not survive a depth change, and the call left the
-// game with a black screen and the launcher with no background once it
-// returned. That is the hazard libpicofe already documented here, and I
-// walked into it.
-//
-// So the directions are read from the evdev device directly. No SDL, no video
-// mode, nothing that can touch the display. If no suitable device turns up,
-// the directions simply stay dead, which is where they were anyway.
-// ---------------------------------------------------------------------------
-#include <linux/input.h>
-#include <fcntl.h>
-#include <errno.h>
-#include <sys/ioctl.h>
-#include <unistd.h>
-#include <dirent.h>
-
-#define ASP_MAX_KBD 4
-
-static int asp_kbd_fd[ASP_MAX_KBD];
-static int asp_kbd_count = -1;			// -1 = not yet opened
-static unsigned char asp_dir_down[4];	// up, down, left, right
-
-static int asp_dir_index(int code)
-{
-	switch (code) {
-	case KEY_UP:    return 0;
-	case KEY_DOWN:  return 1;
-	case KEY_LEFT:  return 2;
-	case KEY_RIGHT: return 3;
-	default:        return -1;
-	}
-}
-
-static int asp_evdev_has_arrows(int fd)
-{
-	// EVIOCGBIT for EV_KEY returns a bitmap of the keys this device can
-	// report. A device that cannot report arrows is not the stick, and
-	// opening every event node indiscriminately would also pick up the
-	// joystick's own node and anything else plugged in.
-	unsigned char bits[(KEY_MAX / 8) + 1];
-	memset(bits, 0, sizeof(bits));
-	if (ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(bits)), bits) < 0)
-		return 0;
-
-	static const int want[] = { KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT };
-	static const char *label[] = { "up", "down", "left", "right" };
-
-	// Any one arrow is enough to be worth reading. Requiring all four would
-	// miss a stick that splits the axes across two nodes, and opening a
-	// device that reports only one of them costs nothing, since only arrow
-	// codes are ever acted on.
-	int found = 0;
-	for (int i = 0; i < 4; i++) {
-		int c = want[i];
-		if (bits[c / 8] & (1 << (c % 8))) {
-			found++;
-			fprintf(stderr, " %s", label[i]);
-		}
-	}
-	return found;
-}
-
-static void asp_evdev_open(void)
-{
-	asp_kbd_count = 0;
-
-	DIR *d = opendir("/dev/input");
-	if (!d) {
-		fprintf(stderr, "asp: cannot open /dev/input (%s); the stick's "
-			"directions will not work\n", strerror(errno));
-		return;
-	}
-
-	struct dirent *e;
-	while ((e = readdir(d)) != NULL && asp_kbd_count < ASP_MAX_KBD) {
-		if (strncmp(e->d_name, "event", 5) != 0) continue;
-
-		char path[280];
-		snprintf(path, sizeof(path), "/dev/input/%s", e->d_name);
-
-		int fd = open(path, O_RDONLY | O_NONBLOCK);
-		if (fd < 0) continue;
-
-		char name[128] = "";
-		ioctl(fd, EVIOCGNAME(sizeof(name)), name);
-		fprintf(stderr, "asp: %s (%s) reports:", path,
-			name[0] ? name : "unnamed");
-
-		if (asp_evdev_has_arrows(fd)) {
-			fprintf(stderr, " - reading directions from it\n");
-			asp_kbd_fd[asp_kbd_count++] = fd;
-		} else {
-			fprintf(stderr, " no arrows, skipped\n");
-			close(fd);
-		}
-	}
-	closedir(d);
-
-	if (asp_kbd_count == 0) {
-		fprintf(stderr, "asp: no input device reports arrow keys; the "
-			"stick's directions will not work\n");
-	}
-}
-
-// One bounded trace of what the stick really sends.
-//
-// "Up and down not really working, a bit random" has several possible causes
-// that cannot be told apart by reasoning: the physical directions might send
-// codes other than the four arrows this device advertises; the driver might
-// report a press with no matching release; or it might autorepeat in a way
-// that makes a held direction look like it keeps letting go. Guessing cost
-// two build-and-test rounds already, so this records the first
-// ASP_TRACE_EVENTS key events - every code, not just arrows - and then stops
-// writing for good.
-#define ASP_TRACE_EVENTS 120
-
-static FILE *asp_trace = NULL;
-static int asp_trace_left = ASP_TRACE_EVENTS;
-
-static void asp_trace_open(void)
-{
-	static const char *paths[] = {
-		"/mnt/hdisk/ASPh/hack/bin/fba/fba_input.log",
-		"/mnt/udisk/ASPh/hack/bin/fba/fba_input.log",
-		NULL
-	};
-	for (int i = 0; paths[i] && !asp_trace; i++) asp_trace = fopen(paths[i], "w");
-	if (!asp_trace) return;
-	setvbuf(asp_trace, NULL, _IOLBF, 0);
-	fprintf(asp_trace, "# first %d key events, then this file stops growing.\n",
-		ASP_TRACE_EVENTS);
-	fprintf(asp_trace, "# arrows are up=%d down=%d left=%d right=%d\n",
-		KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT);
-	fprintf(asp_trace, "# value 1=press 2=repeat 0=release\n");
-}
-
-static void asp_trace_event(const struct input_event *ev)
-{
-	if (asp_trace_left <= 0) return;
-	if (!asp_trace) asp_trace_open();
-	if (!asp_trace) { asp_trace_left = 0; return; }
-
-	const char *name = "";
-	switch (ev->code) {
-	case KEY_UP:    name = " (up)";    break;
-	case KEY_DOWN:  name = " (down)";  break;
-	case KEY_LEFT:  name = " (left)";  break;
-	case KEY_RIGHT: name = " (right)"; break;
-	default: break;
-	}
-	// SDL's millisecond clock rather than the event timestamp: this kernel's
-	// input_event does not expose .time under these headers, and relative
-	// timing is all that matters for spotting a press with no release or a
-	// direction that keeps flickering.
-	fprintf(asp_trace, "%8u ms  code %d%s  value %d\n",
-		SDL_GetTicks(), ev->code, name, ev->value);
-
-	if (--asp_trace_left <= 0) {
-		fprintf(asp_trace, "# limit reached, no further writes\n");
-		fflush(asp_trace);
-		fsync(fileno(asp_trace));
-		fclose(asp_trace);
-		asp_trace = NULL;
-	}
-}
-
-static void asp_evdev_poll(void)
-{
-	if (asp_kbd_count <= 0) return;			// opened in piInputInit
-
-	for (int i = 0; i < asp_kbd_count; i++) {
-		struct input_event ev;
-		ssize_t n;
-		// Drain everything queued. Non-blocking, so this ends in EAGAIN.
-		while ((n = read(asp_kbd_fd[i], &ev, sizeof(ev))) == (ssize_t)sizeof(ev)) {
-			if (ev.type != EV_KEY) continue;
-			asp_trace_event(&ev);
-			int d = asp_dir_index(ev.code);
-			if (d < 0) continue;
-			// value 1 = pressed, 2 = autorepeat, 0 = released
-			asp_dir_down[d] = (ev.value != 0);
-		}
-	}
-}
-
-static void asp_evdev_close(void)
-{
-	for (int i = 0; i < asp_kbd_count && i > -1; i++) {
-		close(asp_kbd_fd[i]);
-	}
-	asp_kbd_count = -1;
-	memset(asp_dir_down, 0, sizeof(asp_dir_down));
-}
-
-// Measured on the device with a twelve-press discovery run, not taken from
-// documentation - the figures in the stock RetroArch config are wrong and are
-// what caused the original mis-mapping.
-//
-//   top row:  A red 0    C green 2   grey 3 (LED)   white 6
-//   bottom:   B yellow 1 D blue 5    grey 4 (LED)   white 7
-//   side:     Select 8   Start 9     Options 10     Turbo 11
-//
-// None of the twelve are directions. The stick sends arrow keysyms, which
-// reach FBNeo through keyLookupTable with nothing configured.
-#define ASP_OPTIONS_BUTTON 10
-#endif
