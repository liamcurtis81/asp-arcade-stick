+static void gx_wipezbuf(INT32 noshadow)
+{
+#define GX_ZBUFW	512
+
+	INT32 w = (nScreenWidth);
+	INT32 h = (nScreenHeight);
+
+	UINT8 *zptr = gx_objzbuf;
+	INT32 ecx = h;
+
+	do { memset(zptr, -1, w); zptr += GX_ZBUFW; } while (--ecx);
+
+	if (!noshadow)
+	{
+		zptr = gx_shdzbuf;
+		w <<= 1;
+		ecx = h;
+		do { memset(zptr, -1, w); zptr += (GX_ZBUFW<<1); } while (--ecx);
+	}
+}
