+		SDL_MixAudio(stream, (Uint8*)SDLAudBuffer + nSDLPlayPos, len, nSDLVolume);
+		nSDLPlayPos = end;
+
+		if (nSDLPlayPos == nAudLoopLen)
+		{
+			nSDLPlayPos = 0;
+		}
+	}
+}
+
+static int SDLSoundGetNextSoundFiller(int)                          // int bDraw
+{
+	if (nAudNextSound == NULL)
+	{
+		return 1;
+	}
+	memset(nAudNextSound, 0, nAudSegLen << 2);                  // Write silence into the buffer
+
+	return 0;
+}
+
+static int SDLSoundBlankSound()
+{
+	if (nAudNextSound)
+	{
+		memset(nAudNextSound, 0, nAudSegLen << 2);
+	}
+	return 0;
+}
+
+#define WRAP_INC(x) { x++; if (x >= nAudSegCount) x = 0; }
+
+static int SDLSoundCheck()
+{
+	int nPlaySeg, nFollowingSeg;
+
+	if (!bAudPlaying)
+		return 1;
+
+	// Since the SDL buffer is smaller than a segment, only fill the buffer up to the start of the currently playing segment
+	nPlaySeg = nSDLPlayPos / (nAudSegLen << 2) - 1;
+
+	if (nPlaySeg >= nAudSegCount)
+	{
+		nPlaySeg -= nAudSegCount;
+	}
+	if (nPlaySeg < 0)
+	{
+		nPlaySeg = nAudSegCount - 1;
+	}
+
+	if (nSDLFillSeg == nPlaySeg) {
+		//	delay_ticks(1);
+			return 0;
+		}
+
+	// work out which seg we will fill next
+	nFollowingSeg = nSDLFillSeg;
+	WRAP_INC(nFollowingSeg);
+
+#ifdef BUILD_ASP
+	// Count the frames in this catch-up batch. Only the last one is drawn, so
+	// a batch size that is reliably 2 is exactly why the rendered rate sits at
+	// half the emulated rate, whatever the drawing costs.
+	{
+		extern unsigned int asp_batch_hist[9];
+		int n = nPlaySeg - nSDLFillSeg;
+		if (n < 0) n += nAudSegCount;
+		if (n > 8) n = 8;
+		if (n > 0) asp_batch_hist[n]++;
+	}
+#endif
+
+	while (nSDLFillSeg != nPlaySeg)
+	{
+		int bDraw;
+
+		bDraw = (nFollowingSeg == nPlaySeg) || bAlwaysDrawFrames;	// If this is the last seg of sound, flag bDraw (to draw the graphics)
+
+#ifdef BUILD_ASP
+		// Displayed frames are unevenly spaced because the batch size varies:
+		// measured on metamrph, 1:657 2:1036 3:1407 5:15, a mean of 2.26. The
+		// gap-1 draws are the ragged part, and suppressing those is the whole
+		// of what this does.
+		if (asp_draw_every_n > 0) {
+			static unsigned int since = 0;
+			since++;
+
+			// Upstream's rule - draw only on the last frame of the batch - is an
+			// audio safety property, not an arbitrary choice. By the last frame
+			// every pending segment has been filled, so the 10.55 ms the drawing
+			// costs is spent with the buffer at its fullest. Pacing the draw by a
+			// counter alone broke that: it drew mid-batch, with segments still
+			// unfilled, and raised the draw rate from 0.44 per frame (one per
+			// batch, mean 2.26) to 0.50. Both drain the buffer, and the result was
+			// audible as clashing and booming - underruns, not a mixing fault.
+			//
+			// So the cadence now only ever suppresses a draw, never adds one: it
+			// still fires at a batch end, but not until n frames have passed. That
+			// removes the gap-1 draws that made the spacing ragged while keeping
+			// the draw rate at or below upstream's, and it is self-correcting,
+			// because a suppressed slot is taken at the next batch end.
+			// With asp_draw_lead the frame before the batch end counts too, so
+			// a batch of 3 offers two chances rather than one. One segment is
+			// then still unfilled while the drawing happens, which is strictly
+			// less cushion than waiting - hence opt-in.
+			int at_end = bDraw;
+			if (asp_draw_lead && !at_end) {
+				int behind = nPlaySeg - nSDLFillSeg;
+				if (behind < 0) behind += nAudSegCount;
+				if (behind == 2) at_end = 1;   // one fill short of the end
+			}
+			bDraw = at_end;
+			if (bDraw) {
+				if ((int)since >= asp_draw_every_n) {
+					since = 0;
+				} else {
+					bDraw = 0;             // too soon; wait for the next batch end
+				}
+			}
+			// asp_draw_guard is no longer consulted. Being "not too far behind"
+			// was a proxy for having buffer cushion, and the last-frame-of-batch
+			// test is the real thing it was approximating.
+		}
+#endif
+		GetNextSound(bDraw);                                // get more sound into nAudNextSound
+
+		if (nAudDSPModule[0])
+		{
+			DspDo(nAudNextSound, nAudSegLen);
+		}
+
+		memcpy((char*)SDLAudBuffer + nSDLFillSeg * (nAudSegLen << 2), nAudNextSound, nAudSegLen << 2);
+
+		nSDLFillSeg = nFollowingSeg;
+		WRAP_INC(nFollowingSeg);
+	}
+
+	return 0;
+}
+
+static int SDLSoundExit()
+{
+	DspExit();
+	SDL_CloseAudio();
+
+	free(SDLAudBuffer);
+	SDLAudBuffer = NULL;
+
+	free(nAudNextSound);
+	nAudNextSound = NULL;
+
+	return 0;
+}
+
+static int SDLSetCallback(int (*pCallback)(int))
+{
+	if (pCallback == NULL)
+	{
+		GetNextSound = SDLSoundGetNextSoundFiller;
+	}
+	else
+	{
+		GetNextSound = pCallback;
+	}
+	return 0;
+}
+
+static int SDLSoundInit()
+{
+	SDL_AudioSpec audiospec_req;
+	int nSDLBufferSize;
+
+	printf("SDLSoundInit (%dHz) (%dFPS)\n", nAudSampleRate[0], nAppVirtualFps);
+
+	if (nAudSampleRate[0] <= 0)
+	{
+		return 1;
+	}
+
+	nSoundFps = nAppVirtualFps;
+
+#ifdef BUILD_ASP
+	/* The cushion exists to absorb cost peaks, so cheaper frames need less of
+	 * it - and less cushion is less lag, which is the only way to improve both
+	 * at once. The sound chips generate one frame of audio per emulated frame,
+	 * so halving the rate halves the samples they must produce. It does not
+	 * change segment DURATION, so it costs nothing in latency directly; the
+	 * gain is in the slack per cycle, and the loss is sound quality. */
+	// ALWAYS authoritative, never "leave alone". FBNeo writes nAudSampleRate
+	// into fbneo.ini on exit and ConfigAppLoad restores it, so a rate tried
+	// once is stuck: after 22050 ran, setting the tuning key back to 0 changed
+	// nothing, because 0 meant leave-alone and what was left was the saved
+	// 22050. The log said "audio_rate = 0" and reported 22050 Hz in the same
+	// breath. So 0 now means FBNeo's own default, and the card file always
+	// wins over the ini.
+	int want = (asp_aud_rate_override >= 8000
+		&& asp_aud_rate_override <= 48000) ? asp_aud_rate_override : 44100;
+	nAudSampleRate[0] = want;
+#endif
+
+#ifdef BUILD_ASP
+	/* One segment is one video frame of audio, and the fill loop always tops
+	 * the ring up to within one segment of the play point, so there are
+	 * steadily nAudSegCount-1 frames of sound queued ahead of what is being
+	 * heard. At 6 segments that is about 85 ms, while the picture is shown the
+	 * instant it is drawn - which is the lip-sync gap. Fewer segments tightens
+	 * it and leaves less cushion against the underruns that made v13 boom, so
+	 * this is a genuine trade and belongs in the tuning file. */
+	if (asp_aud_segments >= 2 && asp_aud_segments <= 16) {
+		nAudSegCount = asp_aud_segments;
+	}
+#endif
+
+	nAudSegLen = (nAudSampleRate[0] * 100 + (nSoundFps >> 1)) / nSoundFps;
+	nAudLoopLen = (nAudSegLen * nAudSegCount) << 2;
+	for (nSDLBufferSize = 64; nSDLBufferSize < (nAudSegLen >> 1); nSDLBufferSize <<= 1)
+	{
+
+	}
+
+#ifdef BUILD_ASP
+	/* The device buffer is latency on top of the ring - 512 samples measured
+	 * as 11.6 ms of the 62 ms total, about a fifth of it. Smaller means the
+	 * driver has less margin of its own, so this is opt-in. */
+	if (asp_aud_device_samples >= 64 && asp_aud_device_samples <= 4096
+			&& asp_aud_device_samples < nSDLBufferSize) {
+		nSDLBufferSize = asp_aud_device_samples;
+	}
+#endif
+
+	audiospec_req.freq = nAudSampleRate[0];
+	audiospec_req.format = AUDIO_S16;
+	audiospec_req.channels = 2;
+	audiospec_req.samples = nSDLBufferSize;
+	audiospec_req.callback = audiospec_callback;
+
+	SDLAudBuffer = (short*)malloc(nAudLoopLen);
+	if (SDLAudBuffer == NULL)
+	{
+		printf("Couldn't malloc SDLAudBuffer\n");
+		SDLSoundExit();
+		return 1;
+	}
+	memset(SDLAudBuffer, 0, nAudLoopLen);
+
+	nAudNextSound = (short*)malloc(nAudSegLen << 2);
+	if (nAudNextSound == NULL)
+	{
+		SDLSoundExit();
+		return 1;
+	}
+
+	nSDLPlayPos = 0;
+	nSDLFillSeg = nAudSegCount - 1;
+
+	if (SDL_OpenAudio(&audiospec_req, &audiospec))
+	{
+		fprintf(stderr, "Couldn't open audio: %s\n", SDL_GetError());
+		return 1;
+	}
+#ifdef BUILD_ASP
+	asp_aud_rate = nAudSampleRate[0];
+	asp_aud_seglen = nAudSegLen;
+	asp_aud_segs = nAudSegCount;
+	asp_aud_dev_samples = audiospec.samples;
+	asp_aud_dev_size = audiospec.size;
+	asp_aud_dev_freq = audiospec.freq;
+	asp_aud_want_rate = want;
+#endif
+	DspInit();
+	SDLSetCallback(NULL);
+
+	return 0;
+}
+
+static int SDLSoundPlay()
+{
+	SDL_PauseAudio(0);
+	bAudPlaying = 1;
+
+	return 0;
+}
+
+static int SDLSoundStop()
+{
+	SDL_PauseAudio(1);
+	bAudPlaying = 0;
+
+	return 0;
+}
+
+static int SDLSoundSetVolume()
+{
+	nSDLVolume = int(SDL_MIX_MAXVOLUME * nAudVolume / 10000);
+	if (nSDLVolume > SDL_MIX_MAXVOLUME) nSDLVolume=SDL_MIX_MAXVOLUME;
+	if (nSDLVolume < 0) nSDLVolume=0;
+	return 1;
+}
+
+static int SDLGetSettings(InterfaceInfo* /* pInfo */)
+{
+	return 0;
+}
+
+struct AudOut AudOutSDL = { SDLSoundBlankSound, SDLSoundCheck, SDLSoundInit, SDLSetCallback, SDLSoundPlay, SDLSoundStop, SDLSoundExit, SDLSoundSetVolume, SDLGetSettings, _T("SDL audio output") };
