+		} else if (strcmp(key, "audio_segments") == 0) {
+			asp_aud_segments = value;
+		} else if (strcmp(key, "draw_lead") == 0) {
+			asp_draw_lead = value;
+		} else if (strcmp(key, "audio_rate") == 0) {
+			asp_aud_rate_override = value;
+		} else if (strcmp(key, "device_samples") == 0) {
+			asp_aud_device_samples = value;
+		} else if (strcmp(key, "hash_frames") == 0) {
+			asp_hash_frames = value;
+		} else {
+			fprintf(stderr, "asp: tuning: unknown key \"%s\", ignored\n", key);
+			continue;
+		}
