+	  $(foreach file,$(autobj:.o=.asm), \
+		$(foreach dir,$(alldir),$(subst $(srcdir),$(objdir), \
+		$(firstword $(subst .asm,.o,$(wildcard $(srcdir)$(dir)/$(file))))))) \
+	  $(foreach file,$(autobj:.o=.rc), \
+		$(foreach dir,$(alldir),$(subst $(srcdir),$(objdir), \
