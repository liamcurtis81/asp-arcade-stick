+#
+#
+#	Specify compiler/linker/assembler
+#
+#
+
+CC	= $(CROSS)gcc
+CXX	= $(CROSS)g++
+
+# FBNeo compiles three small generators and then RUNS them to produce headers
+# (ctv.h, pgm_sprite.h, m68kops.c/h). Built with the cross compiler those are
+# ARM binaries, and the build host cannot execute them - which is exactly the
+# "Error 126" this makefile hit. They are self-contained, stdio only, so they
+# build for the host with no flags beyond -O2.
+#	Do NOT use -mcpu=cortex-a7 here. It tells GCC the chip has the ARMv7
+#	integer divide extension, and GCC then emits sdiv/udiv - 1573 of them in
+#	one build. This chip does not have it. Its /proc/cpuinfo Features line
+#	reads
+#	    swp half thumb fastmult vfp edsp neon vfpv3 tls vfpv4
+#	with no idiva or idivt, where a real Cortex-A7 lists both. Every game
+#	crashed with SIGILL at the first divide, from an unmodified binary.
+#
+#	-march=armv7-a -mtune=cortex-a7 is the correct pair: ARMv7 instruction
+#	selection and A7 scheduling, without assuming hardware divide.
+#
+#	Build for the CPU this device actually has.
+#
+#	Everything on this card - the three working emulators and the stock
+#	fba029743 - is compiled -march=armv5te with soft float. The device is a
+#	Cortex-A7 at 1.308GHz reporting "vfp edsp neon vfpv3 vfpv4". So every
+#	binary on it targets a 1998 instruction set and leaves the FPU unused.
+#
+#	The float side is the lesser half. The bigger cost is that at armv5te GCC
+#	must assume an unaligned 16- or 32-bit load traps, so it emits a
+#	multi-instruction sequence for each one. Emulators read words out of byte
+#	arrays constantly - ROM fetches, tile decodes, sprite lists - and ARMv7
+#	does those in a single instruction.
+#
+#	float-abi is softfp, not hard, deliberately: softfp uses the FPU for
+#	arithmetic while keeping the soft-float calling convention, so this still
+#	links against the sysroot's static SDL, which is armv5te soft-float and
+#	would otherwise be ABI-incompatible.
+HOSTCC	?= gcc
+HOSTCXX	?= g++
+LD	= $(CXX)
+AS	= nasm
+
+#LDFLAGS	= -static
+
+CFLAGS = -march=armv7-a -mtune=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=softfp -O3 -fomit-frame-pointer -Wno-write-strings \
+	   -Wall -Wno-long-long -Wno-sign-compare -Wno-uninitialized -Wno-unused \
+	   -Wno-pedantic -Wno-conversion -Wno-attributes -Wno-unused-but-set-variable \
+	   -Wno-unused-parameter -Wno-unused-value \
+	   -include unistd.h -D_GNU_SOURCE \
+	   $(DEF) $(incdir)
+	   
+CXXFLAGS = -march=armv7-a -mtune=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=softfp -O3 -fomit-frame-pointer -Wno-write-strings \
+	   -Wall -W -pedantic -Wno-long-long \
+	   -Wunknown-pragmas -Wundef -Wconversion -Wno-missing-braces \
+	   -Wuninitialized -Wpointer-arith -Winline -Wno-multichar \
+	   -Wno-pedantic -Wno-conversion -Wno-attributes -Wno-unused-but-set-variable \
+	   -Wno-unused-parameter -Wno-unused-value -Wno-narrowing \
+	   $(DEF) $(incdir)
+
+ASFLAGS	=  -O1 -f coff -w-orphan-labels
+
+#       D3DUtils & D3DMath need these
+#       DEF     = -Dsinf=\(float\)sin -Dcosf=\(float\)cos -Dasinf=\(float\)asin -Dacosf=\(float\)acos -Dsqrtf=\(float\)sqrt
+
+# FIXME
+	DEF	:= -DBUILD_SDL -DBUILD_PI -DBUILD_ASP -DUSE_SPEEDHACKS -DFILENAME=$(NAME) -D__fastcall=
+
+ifdef UNICODE
+	DEF	:= $(DEF) -D_UNICODE
+endif
+
+ifdef SPECIALBUILD
+	DEF	:= $(DEF) -DSPECIALBUILD=$(SPECIALBUILD)
+endif
+
+ifdef FASTCALL
+	DEF	:= $(DEF) -DFASTCALL
+endif
+
+ifdef DEBUG
+	DEF	:= $(DEF) -DFBNEO_DEBUG
+endif
+
+ifdef ROM_VERIFY
+	DEF	:= $(DEF) -DROM_VERIFY
+endif
+
+ifdef INCLUDE_7Z_SUPPORT
+	DEF := $(DEF) -DINCLUDE_7Z_SUPPORT
+endif
+
+ifdef INCLUDE_AVI_RECORDING
+	DEF := $(DEF) -DINCLUDE_AVI_RECORDING
+endif
+
+ifdef LSB_FIRST
+	DEF	:= $(DEF) -DLSB_FIRST
+endif
+
+ifdef INCLUDE_LIB_PNGH
+	DEF	:= $(DEF) -DINCLUDE_LIB_PNGH
+endif
+
+ifdef BUILD_A68K
+	DEF	:= $(DEF) -DBUILD_A68K
+endif
+
+ifdef BUILD_X86_ASM
+	DEF := $(DEF) -DBUILD_X86_ASM
+endif
+
+ifdef BUILD_X64_EXE
+	DEF := $(DEF) -DBUILD_X64_EXE -DXBYAK_NO_OP_NAMES -DMIPS3_X64_DRC
+endif
+
+ifdef	SYMBOL
+
+	CFLAGS   += -ggdb3
+	CXXFLAGS += -ggdb3
+	ASFLAGS  += -g
+	DEF	 := $(DEF) -D_DEBUG
+
+ifdef PROFILE
+	CFLAGS	 += -pg
+	CXXFLAGS += -pg
+else
+	CFLAGS	 += -fomit-frame-pointer
+	CXXFLAGS += -fomit-frame-pointer
+endif
+
+else
+	LDFLAGS	 += -s
+endif
+
+# For zlib
+DEF := $(DEF) -DNO_VIZ -D_LARGEFILE64_SOURCE=0 -D_FILE_OFFSET_BITS=64 -DCHDR_SYSTEM_ZLIB
