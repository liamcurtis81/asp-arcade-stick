+	fprintf(asp_log, "----- startup done, logging off -----\n");
+	fflush(asp_log);
+
+	// Both streams go nowhere from here, so the emulation loop cannot write
+	// to the card no matter how chatty a driver is.
+	int devnull = open("/dev/null", O_WRONLY);
+	if (devnull >= 0) {
+		dup2(devnull, STDOUT_FILENO);
+		dup2(devnull, STDERR_FILENO);
+		close(devnull);
+	}
+	fclose(asp_log);
+	asp_log = NULL;
