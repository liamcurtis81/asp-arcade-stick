+			temp4 = K054338_set_alpha_level(temp2);
+
+			if (temp4 <= 0) return;
+			//if (temp4 < 255) k = (j == GXMIX_BLEND_FAST) ? ~parity : 1;
+		}
+
+		INT32 l = sub2flags & 0xf;
+
+		if (offs == -3)
+		{
+			if (extra_bitmap) // soccer superstars roz layer
+			{
+#if 0 // iq_132
+				INT32 xx,yy;
+				INT32 width = screen.width();
+				INT32 height = screen.height();
