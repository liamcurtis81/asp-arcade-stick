+#endif
 
 // ASP sound Z80 wait (see ZetSetIdleLoop): 067eaa05.4e
 //   BIT 1,(HL=0xec01) ; JP Z,self   - YM2151 timer B flag
@@ -43,7 +47,7 @@ static UINT8 *AllRam;
 static UINT8 *Drv68KRAM;
 static UINT8 *DrvZ80RAM;
 static UINT8 *DrvSprRAM;
-static UINT8 *DrvPalRAM;
+static ASP_TLS UINT8 *DrvPalRAM;
 static UINT8 *RamEnd;
 static UINT8 *MemEnd;
 
@@ -51,14 +55,14 @@ static UINT8 *soundlatch;
 static UINT8 *soundlatch2;
 static UINT8 *soundlatch3;
 
-static UINT32 *DrvPalette;
+static ASP_TLS UINT32 *DrvPalette;
 static UINT8 DrvRecalc;
 
 static INT32 nExtraCycles[2];
 
-static INT32 layerpri[4];
-static INT32 layer_colorbase[4];
-static INT32 sprite_colorbase;
+static ASP_TLS INT32 layerpri[4];
+static ASP_TLS INT32 layer_colorbase[4];
+static ASP_TLS INT32 sprite_colorbase;
 
 static UINT8 DrvJoy1[8];
 static UINT8 DrvJoy2[8];
@@ -72,7 +76,7 @@ static INT32 z80_bank;
 static INT32 sound_nmi_enable;
 static INT32 irq5_timer;
 static UINT16 control_data;
-static INT32 enable_alpha;
+static ASP_TLS INT32 enable_alpha;
 
 static struct BurnInputInfo XexexInputList[] = {
 	{"P1 Coin",			BIT_DIGITAL,	DrvJoy1 + 0,	"p1 coin"		},
@@ -643,6 +647,9 @@ static INT32 DrvInit()
 
 static INT32 DrvExit()
 {
+#ifdef BUILD_ASP
+	asp_async_stop();
+#endif
 	GenericTilesExit();
 
 	KonamiICExit();
@@ -743,6 +750,35 @@ static INT32 DrvDraw()
 	return 0;
 }
 
+#ifdef BUILD_ASP
+// ASP: picture drawn on a second core (burner/pi/asp_async.cpp). The draw reads
+// palette RAM, five video chips and enable_alpha; all are copied here at the
+// scanline the picture is drawn on, and the render thread draws from the copy
+// into its own bitmaps and palette.
+static UINT8 asp_xx_palram[0x2000];
+static INT32 asp_xx_alpha;
+static UINT32 *asp_xx_palette = NULL;  // the render thread's DrvPalette
+
+static void asp_xexex_capture()
+{
+	memcpy(asp_xx_palram, DrvPalRAM, sizeof(asp_xx_palram));
+	asp_xx_alpha = enable_alpha;
+	K056832AspCapture(); K053247AspCapture(); K053250AspCapture();
+	K054338AspCapture(); K053251AspCapture();
+}
+
+static void asp_xexex_bind()
+{
+	if (asp_xx_palette == NULL) asp_xx_palette = (UINT32*)malloc(0x1000 * sizeof(UINT32));
+	DrvPalRAM = asp_xx_palram;
+	DrvPalette = konami_palette32 = asp_xx_palette;
+	enable_alpha = asp_xx_alpha;
+	K056832AspBind(); K053247AspBind(); K053250AspBind();
+	K054338AspBind(); K053251AspBind();
+	KonamiAspBindBitmaps();
+}
+#endif
+
 static INT32 DrvFrame()
 {
 	if (DrvReset) {
@@ -797,6 +833,9 @@ static INT32 DrvFrame()
 
 		if (i == 106) {
 			if (pBurnDraw) {
+#ifdef BUILD_ASP
+				if (!asp_async_draw(asp_xexex_capture, asp_xexex_bind, DrvDraw, nScreenHeight))
+#endif
 				DrvDraw();
 			}
 		}
