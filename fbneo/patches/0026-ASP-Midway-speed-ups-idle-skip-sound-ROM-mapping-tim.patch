+#ifdef BUILD_ASP
+// ASP: count the rest of this timeslice as spent and end it. Used when a game
+// is provably idling (spinning until an interrupt); unlike tms34010_stop the
+// cycles are accounted, so the frame's timing is unchanged.
+void tms34010_burn_timeslice()
+{
+	// stop at the internal timer if it would expire first: it is advanced by
+	// executed cycles, so skipping past it would delay its interrupt (DMA end)
+	INT32 burn = tms34010_ICount;
+	if (state.timer_active && state.timer_cyc < burn) burn = state.timer_cyc;
+	if (burn <= 0) return;
+	tms34010_ICount -= burn;
+	check_timer(burn);
+}
+#endif
