+#ifdef BUILD_ASP
+// ASP: idle skipping. Between frames these games spin in a loop that calls a
+// list-walking routine and then polls a RAM flag the vblank interrupt sets.
+// When the flag reads zero, from that loop, and every list the routine walks
+// is empty, the rest of the loop iteration can do nothing until the next
+// interrupt; interrupts are only raised between timeslices, so the rest of
+// the timeslice is counted as spent instead of executed. Found by profiling
+// (the loop was over half the TMS34010's time on Mortal Kombat); the same
+// check MAME used for these boards. Any mismatch in code (other revisions)
+// fails the PC test and simply runs as before.
+struct asp_idle_def { UINT32 flag, pc_lo, pc_hi; INT32 nlists; UINT32 list[3]; };
+static const asp_idle_def asp_idle_mk = { 0x01053360, 0xffce20d0, 0xffce2100, 3, { 0x0104f9d0, 0x0104fa10, 0x0104fa30 } };
+static const asp_idle_def asp_idle_mk2 = { 0x01068e70, 0xff80db40, 0xff80db70, 3, { 0x0105d480, 0x0105d4a0, 0x0105d4c0 } };
+static const asp_idle_def *asp_idle = NULL;
+UINT32 asp_idle_hits = 0, asp_idle_calls = 0, asp_idle_flagreads = 0, asp_idle_lastpc = 0, asp_idle_zero = 0;
+
+static inline UINT32 asp_ram32(UINT32 bitaddr)
+{
+	UINT16 *w = (UINT16*)(DrvRAM + ((bitaddr - 0x01000000) >> 3));
+	return w[0] | ((UINT32)w[1] << 16);
+}
+
+static UINT16 asp_idle_read(UINT32 address)
+{
+	UINT16 v = *(UINT16*)(DrvRAM + (((address & ~0xf) - 0x01000000) >> 3));
+	asp_idle_calls++;
+	if (address == asp_idle->flag) { asp_idle_flagreads++; asp_idle_lastpc = TMS34010GetPC(); if (v == 0) asp_idle_zero++; }
+	// the flag is a 16-bit field (the word above it is a different variable)
+	if (address == asp_idle->flag && v == 0) {
+		UINT32 pc = TMS34010GetPC();
+		if (pc >= asp_idle->pc_lo && pc <= asp_idle->pc_hi) {
+			INT32 i;
+			for (i = 0; i < asp_idle->nlists; i++)
+				if (asp_ram32(asp_idle->list[i]) != 0) break;
+			if (i == asp_idle->nlists) { TMS34010BurnTimeslice(); asp_idle_hits++; }
+		}
+	}
+	return v;
+}
+
+static void asp_idle_install()
+{
+	asp_idle = NULL;
+	if (TUnitIsMK && !TUnitIsMKTurbo) asp_idle = &asp_idle_mk;
+	if (TUnitIsMK2) asp_idle = &asp_idle_mk2;
+	if (asp_idle == NULL || getenv("ASP_NO_IDLE_SKIP")) return;
+	// reads of the flag's 512-byte page go through the check; writes stay direct
+	TMS34010SetReadHandler(20, asp_idle_read);
+	TMS34010MapHandler(20, asp_idle->flag & ~0xfff, (asp_idle->flag & ~0xfff) + 0xfff, MAP_READ);
+}
+#endif
