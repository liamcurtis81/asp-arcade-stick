 };
 
+#ifdef BUILD_ASP
+// ASP: idle skipping, as on the T-unit (midtunit.cpp): between frames the game
+// calls a list routine and polls a 16-bit RAM flag the vblank interrupt sets.
+// When the flag is zero, from that loop, and the list is empty, the rest of
+// the timeslice (up to the CPU's own timer) is counted as spent. Smash TV:
+// found by profiling, the loop was 27% of the TMS34010's time in the demo.
+struct asp_idle_y_def { const char *name; UINT32 flag, pc_lo, pc_hi; INT32 nlists; UINT32 list[3]; };
+// Smash TV's loop (flag 0x01086760, PCs ffe0a310-ffe0a340, list 0x01000040)
+// was tried and removed: its object list is rarely empty while it waits, so
+// the skip seldom applied and gave no measurable gain.
+static const asp_idle_y_def asp_idle_y_defs[] = {
+	{ NULL, 0, 0, 0, 0, { 0 } },
+};
+static const asp_idle_y_def *asp_idle_y = NULL;
+UINT32 asp_idle_y_hits = 0;
+
+static inline UINT32 asp_yram32(UINT32 bitaddr)
+{
+	UINT16 *w = (UINT16*)(DrvMainRAM + ((bitaddr - 0x01000000) >> 3));
+	return w[0] | ((UINT32)w[1] << 16);
+}
+
+static UINT16 asp_idle_y_read(UINT32 address)
+{
+	UINT16 v = *(UINT16*)(DrvMainRAM + (((address & ~0xf) - 0x01000000) >> 3));
+	if (address == asp_idle_y->flag && v == 0) {
+		UINT32 pc = TMS34010GetPC();
+		if (pc >= asp_idle_y->pc_lo && pc <= asp_idle_y->pc_hi) {
+			INT32 i;
+			for (i = 0; i < asp_idle_y->nlists; i++)
+				if (asp_yram32(asp_idle_y->list[i]) != 0) break;
+			if (i == asp_idle_y->nlists) { TMS34010BurnTimeslice(); asp_idle_y_hits++; }
+		}
+	}
+	return v;
+}
+
+static void asp_idle_install_y()
+{
+	asp_idle_y = NULL;
+	for (UINT32 i = 0; i < sizeof(asp_idle_y_defs) / sizeof(asp_idle_y_defs[0]); i++)
+		if (asp_idle_y_defs[i].name && strcmp(BurnDrvGetTextA(DRV_NAME), asp_idle_y_defs[i].name) == 0) asp_idle_y = &asp_idle_y_defs[i];
+	if (asp_idle_y == NULL || getenv("ASP_NO_IDLE_SKIP")) return;
+	TMS34010SetReadHandler(4, asp_idle_y_read);
+	TMS34010MapHandler(4, asp_idle_y->flag & ~0xfff, (asp_idle_y->flag & ~0xfff) + 0xfff, MAP_READ);
+}
+#endif
+
