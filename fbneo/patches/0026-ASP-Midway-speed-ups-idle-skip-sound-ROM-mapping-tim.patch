+	FILE *pf = fopen("/tmp/claude-0/pcprof.txt", "a"); if (!pf) return;
+	UINT64 tot = 0; for (int i = 0; i < (1<<20); i++) tot += pp_cyc[i];
+	for (int n = 0; n < 40; n++) {
+		int b = -1; for (int i = 0; i < (1<<20); i++) if (pp_cyc[i] && (b < 0 || pp_cyc[i] > pp_cyc[b])) b = i;
+		if (b < 0) break;
+		fprintf(pf, "pcprof %08x %6.2f%%\n", pp_pc[b], 100.0 * pp_cyc[b] / tot); pp_cyc[b] = 0;
+	}
+	fclose(pf);
+}
+#endif
