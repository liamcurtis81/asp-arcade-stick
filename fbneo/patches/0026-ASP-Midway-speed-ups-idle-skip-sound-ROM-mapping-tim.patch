diff --git a/src/burn/timer.h b/src/burn/timer.h
index 0b5d70a..a3c7a33 100644
--- a/src/burn/timer.h
+++ b/src/burn/timer.h
@@ -4,8 +4,28 @@
 // FM timers
 
 #define TIMER_TICKS_PER_SECOND (2048000000)
+#if defined(BUILD_ASP)
+// ASP: the stick's Cortex-A7 has no integer divide, so every 64-bit division
+// here became a call to a slow software routine; these run several times per
+// timer step in every game with FM sound (12% of the sound time on Mortal
+// Kombat). The VFP unit does divide, so the quotient is estimated in double
+// and corrected with integer multiplies: the result is exactly what the
+// 64-bit integer division gives (truncation toward zero).
+static inline INT64 asp_muldiv64(INT64 a, INT64 b, INT64 c)
+{
+	INT64 n = a * b;
+	if (n < 0 || c <= 0 || n > ((INT64)1 << 52)) return n / c;
+	INT64 q = (INT64)((double)n / (double)c);
+	while (q > 0 && q * c > n) q--;
+	while ((q + 1) * c <= n) q++;
+	return q;
+}
+#define MAKE_TIMER_TICKS(n, m) asp_muldiv64((INT64)(n), TIMER_TICKS_PER_SECOND, (m))
+#define MAKE_CPU_CYLES(n, m) asp_muldiv64((INT64)(n), (m), TIMER_TICKS_PER_SECOND)
+#else
 #define MAKE_TIMER_TICKS(n, m) ((INT64)(n) * TIMER_TICKS_PER_SECOND / (m))
 #define MAKE_CPU_CYLES(n, m) ((INT64)(n) * (m) / TIMER_TICKS_PER_SECOND)
+#endif
 
 extern "C" double BurnTimerGetTime();
 
