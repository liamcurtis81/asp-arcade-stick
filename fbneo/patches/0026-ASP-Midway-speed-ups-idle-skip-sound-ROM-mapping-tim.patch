+#include <stdlib.h>
+static UINT32 *pp_pc; static UINT64 *pp_cyc; static UINT32 pp_last_pc; static INT32 pp_last_ic = -1;
+void asp_pcprof_hit(UINT32 pc, INT32 icount)
+{
+	if (!pp_pc) { pp_pc = (UINT32*)calloc(1<<20, 4); pp_cyc = (UINT64*)calloc(1<<20, 8); }
+	if (pp_last_ic >= 0 && pp_last_ic >= icount) { UINT32 k = (pp_last_pc >> 4) & 0xfffff; pp_pc[k] = pp_last_pc; pp_cyc[k] += pp_last_ic - icount; }
+	pp_last_pc = pc; pp_last_ic = icount;
+}
+void asp_pcprof_dump()
+{
