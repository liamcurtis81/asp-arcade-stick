index cf5adf5..e973623 100644
--- a/platform/common/inputmap_kbd.c
+++ b/platform/common/inputmap_kbd.c
@@ -35,9 +35,99 @@ const struct in_default_bind _in_sdl_defbinds[] = {
 	{ SDLK_F12,    IN_BINDTYPE_EMU, PEVB_SWITCH_KBD },
 	{ SDLK_BACKSPACE, IN_BINDTYPE_EMU, PEVB_FF },
 
+#ifdef ASP_BUILD
+	/* Neo Geo Arcade Stick Pro. libpicofe reports SDL joystick button N as
