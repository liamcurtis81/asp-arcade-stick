@@ -680,7 +680,29 @@ void emu_prep_defconfig(void)
 	defaultConfig.input_dev1 = PICO_INPUT_PAD_3BTN;
 	defaultConfig.volume = 50;
 	defaultConfig.gamma = 100;
+#ifdef ASP_BUILD
+	/* "HW scaling" means the platform layer scales, which on the ASP is
+	 * the fractional fill in plat_video_flip. Without this the core keeps
+	 * the full 1280x720 as its own buffer and centres a 320x224 image in
+	 * it, so the platform only ever gets a 1:1 copy to do and the picture
+	 * sits small in the middle of the panel. */
+	defaultConfig.scaling = EOPT_SCALE_HW;
+	defaultConfig.vscaling = EOPT_SCALE_HW;
+	/* The stick has six face buttons, so present a six-button pad. On the
+	 * stock three-button default the top row (A, C and the grey one, bound
+	 * to X, Y and Z) reaches the console as nothing at all, which reads as
+	 * half the buttons being unmapped. Games that only know the three-button
+	 * pad are unaffected; they ignore the extra reads. The few that read the
+	 * pad in a way a six-button one breaks can be set back to three in
+	 * Options -> Input device 1.
+	 *
+	 * This is the default, so a config already saved on the card wins over
+	 * it. Check for one when installing. */
+	defaultConfig.input_dev0 = PICO_INPUT_PAD_6BTN;
+	defaultConfig.input_dev1 = PICO_INPUT_PAD_6BTN;
+#else
 	defaultConfig.scaling = 0;
+#endif
 	defaultConfig.turbo_rate = 15;
 	defaultConfig.msh2_khz = PICO_MSH2_HZ / 1000;
 	defaultConfig.ssh2_khz = PICO_SSH2_HZ / 1000;
