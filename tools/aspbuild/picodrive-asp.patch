+	{ SDLK_WORLD_0 + 2,  IN_BINDTYPE_PLAYER12, GBTN_Y },      /* C green   */
+	{ SDLK_WORLD_0 + 3,  IN_BINDTYPE_PLAYER12, GBTN_Z },      /* grey top  */
+	{ SDLK_WORLD_0 + 1,  IN_BINDTYPE_PLAYER12, GBTN_A },      /* B yellow  */
+	{ SDLK_WORLD_0 + 5,  IN_BINDTYPE_PLAYER12, GBTN_B },      /* D blue    */
+	{ SDLK_WORLD_0 + 4,  IN_BINDTYPE_PLAYER12, GBTN_C },      /* grey bot  */
+	{ SDLK_WORLD_0 + 9,  IN_BINDTYPE_PLAYER12, GBTN_START },  /* Start     */
+	{ SDLK_WORLD_0 + 8,  IN_BINDTYPE_PLAYER12, GBTN_MODE },   /* Select    */
+	{ SDLK_WORLD_0 + 10, IN_BINDTYPE_EMU, PEVB_MENU },        /* Options   */
