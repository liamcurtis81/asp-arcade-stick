+};
+
+#ifdef ASP_BUILD
+/* 8BitDo M30 through the Mayflash Magic-S Pro 2 adaptor: SDL joystick 0 with
+ * 16 buttons, d-pad on the hat (turned into the arrow keys in in_sdl.c), and
