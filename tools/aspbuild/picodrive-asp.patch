+#ifdef ASP_FULLSCREEN_FILL
+/* Nearest-neighbour stretch of a 16bpp image to fill the whole destination.
+ * The ASP framebuffer is a fixed 1280x720 and has no usable hw scaler or
+ * overlay, so integer scaling would letterbox a 320x224 Mega Drive frame to
+ * 960x672. This fills the panel instead. Rows that map to the same source
+ * line are memcpy'd from the previous destination row, so for 224->720 only
+ * 224 of the 720 rows are actually built. */
+/* Where on the panel the emulated frame goes. Two independent corrections:
+ *
+ * Overscan - the framebuffer is 1280x720 and we fill it, but the panel shows
+ * less than all of it, so edge content falls off and the picture reads as
+ * running past the screen edge. Drawing into a smaller centred rectangle is
+ * the cure; how much smaller belongs to the display, so it comes from
+ * asp_screen.cfg beside the binary and can be corrected without a rebuild.
+ *
+ * Aspect - the Mega Drive is a 4:3 system whether the mode is 256 or 320
+ * pixels wide. Scaling it to 16:9 stretches it sideways by a third regardless
+ * of overscan, so fit 4:3 inside what the overscan leaves and let the slack be
+ * side bars instead of distortion.
+ */
+static int asp_inset_x, asp_inset_y;
+static int asp_keep_aspect = 1;
+static int asp_calibrate;
+/* Which reading of the display's contradictory geometry to trust;
+ * see asp_fbout.h. 0 picks automatically. */
+static int asp_fb_mode;
+/* What the display physically is, so the frame can be pre-shaped to come out
+ * 4:3 after the display scales the framebuffer onto it. 16:9 means the display
+ * matches the framebuffer and nothing needs correcting. */
+static int asp_panel_w = 16, asp_panel_h = 9;
+static void asp_read_screen_cfg(void);
+#include "asp_fbout.h"
+#include "asp_calib.h"
+#include "asp_geom.h"
+
+static void asp_read_screen_cfg(void)
+{
+	char path[512], line[256];
+	FILE *f;
+	int n;
+
+	n = readlink("/proc/self/exe", path, sizeof(path) - 24);
+	if (n <= 0)
+		return;
+	path[n] = 0;
+	while (n > 0 && path[n - 1] != '/')
+		n--;
+	strcpy(path + n, "asp_screen.cfg");
+
+	f = fopen(path, "r");
+	if (f == NULL) {
+		fprintf(stderr, "asp: no %s, filling the panel\n", path);
+		return;
+	}
+	while (fgets(line, sizeof(line), f) != NULL) {
+		int v, pw, ph;
+		char word[64];
+		if (line[0] == '#' || line[0] == '\n' || line[0] == '\r')
+			continue;
+		if (sscanf(line, "inset_x = %d", &v) == 1 ||
+		    sscanf(line, "inset_x=%d", &v) == 1)
+			asp_inset_x = v;
+		else if (sscanf(line, "inset_y = %d", &v) == 1 ||
+		         sscanf(line, "inset_y=%d", &v) == 1)
+			asp_inset_y = v;
+		else if (sscanf(line, "aspect = %63s", word) == 1 ||
+		         sscanf(line, "aspect=%63s", word) == 1)
+			asp_keep_aspect = (strncmp(word, "fill", 4) != 0);
+		else if (sscanf(line, "calibrate = %d", &v) == 1 ||
+		         sscanf(line, "calibrate=%d", &v) == 1)
+			asp_calibrate = v;
+		else if (sscanf(line, "fb_mode = %d", &v) == 1 ||
+		         sscanf(line, "fb_mode=%d", &v) == 1)
+			asp_fb_mode = v;
+		else if (sscanf(line, "panel_aspect = %d:%d", &pw, &ph) == 2 ||
+		         sscanf(line, "panel_aspect=%d:%d", &pw, &ph) == 2) {
+			if (pw > 0 && ph > 0) { asp_panel_w = pw; asp_panel_h = ph; }
+		}
+	}
+	fclose(f);
+
+	if (asp_inset_x < 0) asp_inset_x = 0;
+	if (asp_inset_y < 0) asp_inset_y = 0;
+	if (asp_inset_x > 320) asp_inset_x = 320;
+	if (asp_inset_y > 180) asp_inset_y = 180;
+
+	fprintf(stderr, "asp: %s -> inset_x=%d inset_y=%d aspect=%s calibrate=%d\n",
+		path, asp_inset_x, asp_inset_y,
+		asp_keep_aspect ? "keep" : "fill", asp_calibrate);
+	fprintf(stderr, "asp: fb_mode=%d panel_aspect=%d:%d\n",
+		asp_fb_mode, asp_panel_w, asp_panel_h);
+}
+
+/* The surface-based target-rect helper lived here. It is replaced by
+ * asp_target_rect_fb() in asp_geom.h, which works against the real
+ * framebuffer geometry rather than the SDL surface whose pitch is half
+ * the driver's line_length on this device. */
+
+void copy_fracscale(void *dst, int w, int h, int pp, void *src, int sw, int sh, int spp)
+{
+	static unsigned short xmap[2048];
+	static int cache_w, cache_sw;
+	unsigned short *p = (unsigned short *)dst;
+	unsigned short *q = (unsigned short *)src;
+	unsigned short *prev_row = NULL;
+	int i, j, prev_sy = -1;
+
+	if (w > 2048)
+		w = 2048;
+	if (w <= 0 || h <= 0 || sw <= 0 || sh <= 0)
+		return;
+
+	if (w != cache_w || sw != cache_sw) {
+		for (j = 0; j < w; j++)
+			xmap[j] = (unsigned short)(((unsigned)j * sw) / w);
+		cache_w = w;
+		cache_sw = sw;
+	}
+
+	for (i = 0; i < h; i++, p += pp) {
+		int sy = (int)(((unsigned)i * sh) / h);
+		if (sy == prev_sy && prev_row != NULL) {
+			memcpy(p, prev_row, w * 2);
+			continue;
+		}
+		{
+			unsigned short *s = q + sy * spp;
+			for (j = 0; j < w; j++)
+				p[j] = s[xmap[j]];
+		}
+		prev_sy = sy;
+		prev_row = p;
+	}
+}
+
+/* Same stretch, but writing 32bpp. The ASP framebuffer may be 32bpp: in
+ * stock PicoDrive the surface is forced to 16bpp inside
+ * plat_sdl_change_video_mode, which the fill path above deliberately never
+ * calls, so the surface keeps whatever depth the framebuffer has and the
+ * RGB565 frame has to be expanded here instead. Shifts come from the
+ * surface so the channel order is whatever SDL reports. */
+void copy_fracscale32(void *dst, int w, int h, int pp, void *src, int sw, int sh,
+		      int spp, const SDL_PixelFormat *fmt)
+{
+	static unsigned short xmap[2048];
+	static int cache_w, cache_sw;
+	unsigned int *p = (unsigned int *)dst;
+	unsigned short *q = (unsigned short *)src;
+	unsigned int *prev_row = NULL;
+	int i, j, prev_sy = -1;
+	unsigned int r5[32], g6[64], b5[32];
+
+	if (w > 2048)
+		w = 2048;
+	if (w <= 0 || h <= 0 || sw <= 0 || sh <= 0)
+		return;
+
+	/* RGB565 component -> 8 bit, pre-shifted into place */
+	for (i = 0; i < 32; i++) {
+		unsigned int v = (unsigned int)((i * 255 + 15) / 31);
+		r5[i] = (v >> fmt->Rloss) << fmt->Rshift;
+		b5[i] = (v >> fmt->Bloss) << fmt->Bshift;
+	}
+	for (i = 0; i < 64; i++) {
+		unsigned int v = (unsigned int)((i * 255 + 31) / 63);
+		g6[i] = (v >> fmt->Gloss) << fmt->Gshift;
+	}
+
+	if (w != cache_w || sw != cache_sw) {
+		for (j = 0; j < w; j++)
+			xmap[j] = (unsigned short)(((unsigned)j * sw) / w);
+		cache_w = w;
+		cache_sw = sw;
