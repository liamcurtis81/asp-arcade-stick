+ * build's probe, each button pressed once in a known order:
+ *   Y 0  B 1  C 2  X 3  A 4  heart 5  Z 6  star 7  minus 9  Start 11
+ * Every button where it is on a six-button Mega Drive pad; Mode on heart (the
+ * real pad's Mode sits on its shoulder) and PicoDrive's menu, which is also
+ * the way out of the emulator, on minus. plat_sdl.c picks this table when
+ * joystick 0 has 16 buttons. */
+const struct in_default_bind in_sdl_defbinds_pad[] = {
+	{ SDLK_UP,     IN_BINDTYPE_PLAYER12, GBTN_UP },
+	{ SDLK_DOWN,   IN_BINDTYPE_PLAYER12, GBTN_DOWN },
+	{ SDLK_LEFT,   IN_BINDTYPE_PLAYER12, GBTN_LEFT },
