 /**
  * Pushes the given buffer of bits to the screen.
  */
+
+#ifdef ASP_BUILD
+/* Neo Geo Arcade Stick Pro output path.
+ *
+ * The panel is a fixed 1280x720 32bpp framebuffer whose driver will not
+ * survive a depth change, so the mode is taken exactly as it is and the
+ * NES's 256x240 8bpp frame is scaled up here instead of relying on FCEUX's
+ * integer scale factors (which letterbox badly at this size). Palette
+ * entries are pre-shifted into the surface's own channel layout, so this
+ * works at 16bpp or 32bpp without caring which.
+ */
+static uint32 asp_pal[256];
+static int asp_pal_bpp;
+
+static void asp_build_palette(SDL_Surface *dst, SDL_Color *pal)
+{
+	const SDL_PixelFormat *f = dst->format;
+	int i;
+	for (i = 0; i < 256; i++)
+		asp_pal[i] = ((uint32)(pal[i].r >> f->Rloss) << f->Rshift)
+		           | ((uint32)(pal[i].g >> f->Gloss) << f->Gshift)
+		           | ((uint32)(pal[i].b >> f->Bloss) << f->Bshift);
+	asp_pal_bpp = f->BytesPerPixel;
+}
+
+static void asp_blit(SDL_Surface *dst, const uint8 *src, int sw, int sh, int spitch)
+{
+	static uint16 xmap[2048];
+	static int cache_w, cache_sw;
+	int dw = dst->w, dh = dst->h;
+	int bpp = dst->format->BytesPerPixel;
+	int i, j, prev_sy = -1;
+
+	if (dw > 2048) dw = 2048;
+	if (dw <= 0 || dh <= 0 || sw <= 0 || sh <= 0) return;
+	if (bpp != 2 && bpp != 4) return;  /* never write a depth we cannot */
+
+	if (dw != cache_w || sw != cache_sw) {
+		for (j = 0; j < dw; j++)
+			xmap[j] = (uint16)(((unsigned)j * sw) / dw);
+		cache_w = dw; cache_sw = sw;
+	}
+
+	if (bpp == 2) {
+		int dpp = dst->pitch / 2;
+		uint16 *p = (uint16 *)dst->pixels, *prev = NULL;
+		for (i = 0; i < dh; i++, p += dpp) {
+			int sy = (int)(((unsigned)i * sh) / dh);
+			if (sy == prev_sy && prev) { memcpy(p, prev, dw * 2); continue; }
+			{
+				const uint8 *s = src + sy * spitch;
+				for (j = 0; j < dw; j++) p[j] = (uint16)asp_pal[s[xmap[j]]];
+			}
+			prev_sy = sy; prev = p;
+		}
+	} else {
+		int dpp = dst->pitch / 4;
+		uint32 *p = (uint32 *)dst->pixels, *prev = NULL;
+		for (i = 0; i < dh; i++, p += dpp) {
+			int sy = (int)(((unsigned)i * sh) / dh);
+			if (sy == prev_sy && prev) { memcpy(p, prev, dw * 4); continue; }
