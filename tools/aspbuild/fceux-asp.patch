+int FCEUI_GetCheat(uint32 which, char **name, uint32 *a, uint8 *v, int *compare, int *s, int *type)
+{
+	struct CHEATF *next=cheats;
+	uint32 x=0;
+
+	while(next)
+	{
+		if(x==which)
+		{
+			if(name)
+				*name=next->name;
+			if(a)
+				*a=next->addr;
+			if(v)
+				*v=next->val;
+			if(s)
+				*s=next->status;
+			if(compare)
+				*compare=next->compare;
+			if(type)
+				*type=next->type;
+			return(1);
+		}
+		next=next->next;
+		x++;
+	}
+	return(0);
+}
