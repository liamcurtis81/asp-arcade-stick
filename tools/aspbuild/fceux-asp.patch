+void FCEU_CheatAddRAM(int s, uint32 A, uint8 *p)
+{
+	uint32 AB=A>>10;
+	int x;
+
+	for(x=s-1;x>=0;x--)
+		CheatRPtrs[AB+x]=p-A;
+}
