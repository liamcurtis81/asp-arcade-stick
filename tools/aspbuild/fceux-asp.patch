+ * every row lands somewhere other than where the hardware reads it. */
+static void asp_fb_report(const char *when)
+{
+	struct fb_var_screeninfo v;
+	struct fb_fix_screeninfo f;
+	int fd = open("/dev/fb0", O_RDONLY);
+
+	if (fd < 0) {
+		fprintf(stderr, "asp-fb (%s): open: %s\n", when, strerror(errno));
+		return;
+	}
+	if (ioctl(fd, FBIOGET_VSCREENINFO, &v) == 0 &&
+	    ioctl(fd, FBIOGET_FSCREENINFO, &f) == 0) {
+		fprintf(stderr, "asp-fb (%s): %ux%u virtual %ux%u offset %u,%u "
+			"bpp %u line_length %u smem_len %u implied_bpp %.2f\n",
+			when, v.xres, v.yres, v.xres_virtual, v.yres_virtual,
+			v.xoffset, v.yoffset, v.bits_per_pixel, f.line_length,
+			f.smem_len,
+			v.xres ? (double)f.line_length * 8.0 / (double)v.xres : 0.0);
+	} else {
+		fprintf(stderr, "asp-fb (%s): ioctl: %s\n", when, strerror(errno));
+	}
+	close(fd);
+}
