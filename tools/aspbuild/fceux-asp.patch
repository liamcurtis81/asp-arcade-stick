+static SDL_Surface *asp_set_mode(Uint32 flags)
+{
+	const SDL_VideoInfo *vi = SDL_GetVideoInfo();
+	int w = (vi && vi->current_w >= 256) ? vi->current_w : 1280;
+	int h = (vi && vi->current_h >= 224) ? vi->current_h : 720;
