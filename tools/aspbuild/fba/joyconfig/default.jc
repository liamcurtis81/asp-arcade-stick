# Arcade Stick Pro button map - everything except the six-button fighters.
#
# Values are 1-based: the file says 1 for hardware button 0. The stick's
# twelve indices, measured on the device, not taken from any documentation:
#
#   index (1-based)   control
#   1                 A, red,    top row, leftmost
#   2                 B, yellow, bottom row, leftmost
#   3                 C, green,  top row, second
#   4, 5              the two grey lozenges (LEDs; they never report a press)
#   6                 D, blue,   bottom row, second
#   7                 white,     top row, rightmost
#   8                 white,     bottom row, rightmost
#   9                 Select
#   10                Start
#   11                Options
#   12                Turbo
#
# Directions are not buttons on this stick. It sends arrow keysyms, which
# FBNeo picks up through its keyboard table with nothing configured here.

# Fire 1-4 follow the labels printed on the buttons, so Neo Geo's A B C D
# land where the player reads them. Konami's brawlers use the first three:
# attack, jump, special.
BUTTON1=1
BUTTON2=2
BUTTON3=3
BUTTON4=6
BUTTON5=7
BUTTON6=8

# Fire 7-9 are parked on the grey lozenges deliberately. Without these lines
# FBNeo's own defaults leave them on the white buttons and on Select, so
# Select would insert a coin and press fire 9 at the same time.
BUTTON7=4
BUTTON8=5
BUTTON9=5

COIN=9
START=10

# Options quits. This is the whole reason the exit check in inp_pi.cpp was
# patched: without a quit button the only way out of a game is the power
# switch, and that is what corrupted the card twice.
QUIT=11

# Turbo opens the game's test menu (FBNeo's Diagnostic / Service Mode input).
# CPS2, CPS3 and the Konami and Data East 32-bit boards keep their difficulty
# there, not on DIP switches; the setting is saved in the board's EEPROM,
# which the emulator keeps between plays. Leave the menu the way the game says
# (usually its EXIT line, or Turbo again).
TEST=12
