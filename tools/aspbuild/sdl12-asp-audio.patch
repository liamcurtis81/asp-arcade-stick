+/* ASP (private local build, not for upstream): just-in-time writes.
+   /dev/snd/actsnd takes audio in whole periods of about 46 ms: once one frees,
+   the next 8 KB are accepted at once and the following write blocks for the
+   next 46 ms. SDL mixes each chunk the moment the device will take it, so
+   every sample waits a full extra period in the kernel. With ASP_SND_JIT_MS
+   set, the thread waits that many milliseconds after a period frees before
+   mixing the chunks that fill it, so they are mixed later and spend that much
+   less time queued. Too large and the period is not refilled in time: a
+   crackle. 0 or unset = the stock behaviour. */
+static int asp_jit_ms = -1;
+static int asp_jit_done = 0;
+/* read by the emulator's exit report */
+int asp_sdl_jit_ms = -1, asp_sdl_driver_dsp = 0;
+unsigned int asp_sdl_poll_waits = 0, asp_sdl_poll_calls = 0, asp_sdl_write_blocks = 0, asp_sdl_writes = 0, asp_sdl_sleeps = 0;
+long asp_sdl_write_max_ms = 0, asp_sdl_poll_max_ms = 0;
+/* SNDCTL_DSP_SETFRAGMENT probe on actsnd (ASP_SND_FRAG_COUNT / _SIZE). The
+   node rejects GETFMTS, but the stock emulator sets fragments, rate and
+   channels on it, so it may honour those. -1 = not tried. */
+int asp_sdl_frag_req = -1, asp_sdl_frag_rc = -1, asp_sdl_frag_errno = 0, asp_sdl_frag_got = 0;
+int asp_sdl_ospace_rc = -1, asp_sdl_ospace_frags = 0, asp_sdl_ospace_total = 0, asp_sdl_ospace_size = 0;
+
+static long asp_ms_since(const struct timeval *t0)
+{
+	struct timeval t1;
+	gettimeofday(&t1, NULL);
+	return (t1.tv_sec - t0->tv_sec) * 1000L + (t1.tv_usec - t0->tv_usec) / 1000L;
+}
