 /* This function waits until it is possible to write a full sound buffer */
 static void DSP_WaitAudio(_THIS)
 {
-	/* Not needed at all since OSS handles waiting automagically */
+	struct pollfd p;
+	struct timeval t0;
+	if ( asp_jit_ms < 0 ) {
+		const char *e = SDL_getenv("ASP_SND_JIT_MS");
+		asp_jit_ms = e ? SDL_atoi(e) : 0;
+		if ( asp_jit_ms < 0 || asp_jit_ms > 40 ) asp_jit_ms = 0;
+		asp_sdl_jit_ms = asp_jit_ms;
+	}
+	asp_jit_done = 0;
+	if ( asp_jit_ms == 0 ) return;
+	p.fd = audio_fd; p.events = POLLOUT; p.revents = 0;
+	gettimeofday(&t0, NULL);
+	asp_sdl_poll_calls++;
+	{
+		int r = poll(&p, 1, 200);
+		long w = asp_ms_since(&t0);
+		if ( w > asp_sdl_poll_max_ms ) asp_sdl_poll_max_ms = w;
+		if ( r > 0 && w >= 5 ) {
+			asp_sdl_poll_waits++;
+			usleep(asp_jit_ms * 1000);
+			asp_sdl_sleeps++;
+			asp_jit_done = 1;
+		}
+	}
 }
 
