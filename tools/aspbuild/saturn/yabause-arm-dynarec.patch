 }
 
+void
+AspSoundSync (void)
+{
+  asp_sound_sync();
+}
+
+void
+AspSoundFlush (void)
+{
+  if (asp_sound_nowait && asp_worker_busy && aspq_n[aspq_fill] < ASPQ_MAX * 3 / 4)
+    return;                   /* goes with the next batch */
+  asp_dispatch();
+}
