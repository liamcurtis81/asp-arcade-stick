@@ -30,6 +30,21 @@
 #include "../sh2core.h"
 #include "../yabause.h"
 #include "sh2_dynarec.h"
+void FRTExec(SH2_struct *sh, u32 cycles);
+void WDTExec(SH2_struct *sh, u32 cycles);
+
+/* ASP: this recompiler's ARM code was written for the old memory and timer
+ * API, where the SH-2 being run was the global CurrentSH2. The core now
+ * passes the SH-2 explicitly; these wrappers bridge the two. */
+SH2_struct *CurrentSH2;
+u8  DynReadByte(u32 a) { return MappedMemoryReadByteNocache(CurrentSH2, a); }
+u16 DynReadWord(u32 a) { return MappedMemoryReadWordNocache(CurrentSH2, a); }
+u32 DynReadLong(u32 a) { return MappedMemoryReadLongNocache(CurrentSH2, a); }
+void DynWriteByte(u32 a, u8 v)  { MappedMemoryWriteByteNocache(CurrentSH2, a, v); }
+void DynWriteWord(u32 a, u16 v) { MappedMemoryWriteWordNocache(CurrentSH2, a, v); }
+void DynWriteLong(u32 a, u32 v) { MappedMemoryWriteLongNocache(CurrentSH2, a, v); }
+void DynFRTExec(u32 c) { FRTExec(CurrentSH2, c); }
+void DynWDTExec(u32 c) { WDTExec(CurrentSH2, c); }
 
