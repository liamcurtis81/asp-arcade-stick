+int asp_sound_nowait = 1;   /* sat_options.txt: asp_sound_nowait */
+static void asp_line_point(void)
+{
+  if (!asp_worker_busy) asp_deliver_irqs();
+  /* ASP: if the worker is still on the last batch, keep queuing instead of
+     waiting for it (up to three quarters of the queue, about a frame). The
+     emulation waited 2-7 ms a frame here in 3D games. */
+  if (aspq_lines >= asp_m68k_batch &&
+      (!asp_sound_nowait || !asp_worker_busy || aspq_n[aspq_fill] >= ASPQ_MAX * 3 / 4))
+    asp_dispatch();
+}
+
+void
+ScspExec ()
+{
+  if (!asp_m68k_thread) { asp_sound_sync(); ScspExecReal(); return; }
+  if (scsp.mintf != asp_mintf_proxy) { asp_sound_sync(); asp_real_mintf = scsp.mintf; scsp.mintf = asp_mintf_proxy; }
+  aspq_push(-1);
+  aspq_lines++;
+}
+
 void
 M68KExec (s32 cycles)
+{
+  if (!asp_m68k_thread) { asp_sound_sync(); M68KExecReal(cycles); return; }
+  aspq_push(cycles < 0 ? 0 : cycles);
+}
