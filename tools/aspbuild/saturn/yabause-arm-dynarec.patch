+/* ASP: the sound side (68000 + SCSP) on its own core.
+ * The frame loop's per-line ScspExec and M68KExec calls are queued; every
+ * asp_m68k_batch lines the queue is handed to a worker thread, which runs
+ * them in the original order (ScspExec, then the 68000's cycles, per line)
+ * while the SH-2s carry on. The worker sleeps between batches. Full syncs
+ * (wait for the worker) happen at the end of each frame and before any SH-2
+ * write to the SCSP registers; interrupts the SCSP raises for the main CPUs
+ * are held and delivered on the main thread at the next handover. Sound RAM
+ * is shared unsynchronised. "asp_m68k_thread 0" restores the old timing. */
+#include <pthread.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <time.h>
+int asp_m68k_thread = 1;
+int asp_m68k_batch = 16;
+double asp_m68k_wait_us;          /* main thread time spent waiting for the worker */
+#define ASPQ_MAX 512
+static s32 aspq[2][ASPQ_MAX];     /* >= 0: 68000 cycles; -1: ScspExec */
+static int aspq_n[2], aspq_fill;  /* main fills aspq[aspq_fill] */
+static int aspq_lines;
+static volatile int asp_worker_busy;
+static int asp_worker_up, asp_on_worker;
+static pthread_t asp_worker;
+static pthread_mutex_t asp_mx = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t asp_cv_go = PTHREAD_COND_INITIALIZER, asp_cv_done = PTHREAD_COND_INITIALIZER;
+static volatile int asp_pending_main_irq;
+static void (*asp_real_mintf)(void);
+void ScspExecReal(void);
+static void M68KExecReal(s32 cycles);
+
+static void asp_mintf_proxy(void)
+{
+  if (asp_on_worker)
+    __sync_fetch_and_add(&asp_pending_main_irq, 1);
+  else if (asp_real_mintf)
+    asp_real_mintf();
+}
+static void asp_deliver_irqs(void)
+{
+  int n = asp_pending_main_irq;
+  if (n)
+    {
+      __sync_fetch_and_sub(&asp_pending_main_irq, n);
+      while (n-- > 0 && asp_real_mintf)
+        asp_real_mintf();
+    }
+}
+int asp_sound_tid;   /* the frontend pins it beside the emulation thread */
+static void *asp_worker_main(void *arg)
+{
+  asp_sound_tid = (int)syscall(SYS_gettid);
+  (void)arg;
+  for (;;)
+    {
+      int b, i, n;
+      pthread_mutex_lock(&asp_mx);
+      while (!asp_worker_busy)
+        pthread_cond_wait(&asp_cv_go, &asp_mx);
+      pthread_mutex_unlock(&asp_mx);
+      b = aspq_fill ^ 1;
+      n = aspq_n[b];
+      asp_on_worker = 1;
+      for (i = 0; i < n; i++)
+        {
+          if (aspq[b][i] < 0) ScspExecReal();
+          else M68KExecReal(aspq[b][i]);
+        }
+      asp_on_worker = 0;
+      aspq_n[b] = 0;
+      pthread_mutex_lock(&asp_mx);
+      asp_worker_busy = 0;
+      pthread_cond_signal(&asp_cv_done);
+      pthread_mutex_unlock(&asp_mx);
+    }
+  return NULL;
+}
+static void asp_wait_worker(void)
+{
+  if (!asp_worker_busy) return;
+  {
+    struct timespec a, b;
+    clock_gettime(CLOCK_MONOTONIC, &a);
+    pthread_mutex_lock(&asp_mx);
+    while (asp_worker_busy)
+      pthread_cond_wait(&asp_cv_done, &asp_mx);
+    pthread_mutex_unlock(&asp_mx);
+    clock_gettime(CLOCK_MONOTONIC, &b);
+    asp_m68k_wait_us += (b.tv_sec - a.tv_sec) * 1e6 + (b.tv_nsec - a.tv_nsec) / 1e3;
+  }
+}
+static void asp_dispatch(void)
+{
+  asp_wait_worker();
+  asp_deliver_irqs();
+  if (aspq_n[aspq_fill] == 0) return;
+  if (!asp_worker_up)
+    {
+      asp_worker_up = pthread_create(&asp_worker, NULL, asp_worker_main, NULL) == 0;
+      if (!asp_worker_up)
+        {
+          int i, f = aspq_fill;
+          for (i = 0; i < aspq_n[f]; i++)
+            { if (aspq[f][i] < 0) ScspExecReal(); else M68KExecReal(aspq[f][i]); }
+          aspq_n[f] = 0;
+          return;
+        }
+    }
+  pthread_mutex_lock(&asp_mx);
+  aspq_fill ^= 1;            /* worker takes the filled one */
+  asp_worker_busy = 1;
+  pthread_cond_signal(&asp_cv_go);
+  pthread_mutex_unlock(&asp_mx);
+  aspq_lines = 0;
+}
+/* Full sync: everything queued has run. */
+static void asp_sound_sync(void)
+{
+  if (!asp_worker_up && aspq_n[aspq_fill] == 0) { asp_deliver_irqs(); return; }
+  asp_dispatch();
+  asp_wait_worker();
+  asp_deliver_irqs();
+}
+static void aspq_push(s32 v)
+{
+  if (aspq_n[aspq_fill] >= ASPQ_MAX) asp_dispatch();
+  aspq[aspq_fill][aspq_n[aspq_fill]++] = v;
+}
+/* Per-line sync point the frame loop already calls: hand over a batch every
