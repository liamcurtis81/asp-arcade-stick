+#!/bin/sh
+# Build psx_emu.dge: the PCSX ReARMed core as a static library plus this frontend.
+set -e
+cd "$(dirname "$0")/.."
+S=${SYSROOT:-/home/claude/psxwork/sysroot}
+A="-march=armv7-a -mtune=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=softfp -marm"
+CFLAGS="$A" make -f Makefile.libretro platform=unix STATIC_LINKING=1 HAVE_PHYSICAL_CDROM=0 DYNAREC=ari64 HAVE_NEON=1 BUILTIN_GPU=neon \
+  CC=arm-linux-gnueabi-gcc CXX=arm-linux-gnueabi-g++ AR=arm-linux-gnueabi-ar -j8 >/dev/null
+mv -f pcsx_rearmed_libretro.so libpcsx_asp.a 2>/dev/null || true
+F="-O2 $A -Wall -Wno-unused-function -Wno-unused-variable -Wno-format-truncation -DASP_BUILD"
+arm-linux-gnueabi-gcc $F -I$S/include -I$S/include/SDL -Ideps/libretro-common/include -Iasp -c asp/asp_psx.c -o asp/asp_psx.o
+arm-linux-gnueabi-g++ -static -o asp/psx_emu.dge asp/asp_psx.o libpcsx_asp.a -L$S/lib -lSDL -lz -lpthread -lm -ldl
+arm-linux-gnueabi-strip asp/psx_emu.dge
+echo "divide instructions: $(arm-linux-gnueabi-objdump -d asp/psx_emu.dge | grep -cP '\t(s|u)div\t')"
+ls -l asp/psx_emu.dge
