+#ifdef ASP_BUILD
+#include <fcntl.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <linux/fb.h>
+
+/* Ask the display driver directly what the framebuffer looks like. SDL's
+ * surface is a report of what SDL believes it negotiated, which on this device
+ * has not always matched: the pixel stride is the one number that, if wrong,
+ * puts every row in the wrong place and produces exactly the shear-and-wrap
+ * that has been showing on the TV. */
+static void asp_fb_report(const char *when)
+{
+	struct fb_var_screeninfo v;
+	struct fb_fix_screeninfo f;
+	int fd = open("/dev/fb0", O_RDONLY);
+
+	if (fd < 0) {
+		fprintf(stderr, "asp-fb (%s): open: %s\n", when, strerror(errno));
+		return;
+	}
+	if (ioctl(fd, FBIOGET_VSCREENINFO, &v) == 0 &&
+	    ioctl(fd, FBIOGET_FSCREENINFO, &f) == 0) {
+		fprintf(stderr, "asp-fb (%s): %ux%u virtual %ux%u offset %u,%u "
+			"bpp %u line_length %u smem_len %u implied_bpp %.2f\n",
+			when, v.xres, v.yres, v.xres_virtual, v.yres_virtual,
+			v.xoffset, v.yoffset, v.bits_per_pixel, f.line_length,
+			f.smem_len,
+			v.xres ? (double)f.line_length * 8.0 / (double)v.xres : 0.0);
+		fprintf(stderr, "asp-fb (%s): masks R %u/%u G %u/%u B %u/%u A %u/%u\n",
+			when, v.red.offset, v.red.length,
+			v.green.offset, v.green.length,
+			v.blue.offset, v.blue.length,
+			v.transp.offset, v.transp.length);
+	} else {
+		fprintf(stderr, "asp-fb (%s): ioctl: %s\n", when, strerror(errno));
+	}
+	close(fd);
+}
+
+/* State the disagreement outright rather than leaving it to be inferred from
+ * two numbers printed several lines apart. */
+static void asp_fb_compare(int sdl_pitch, int sdl_pxbytes)
+{
+	struct fb_var_screeninfo v;
+	struct fb_fix_screeninfo f;
+	int fd = open("/dev/fb0", O_RDONLY);
+
+	if (fd < 0)
+		return;
+	if (ioctl(fd, FBIOGET_VSCREENINFO, &v) == 0 &&
+	    ioctl(fd, FBIOGET_FSCREENINFO, &f) == 0) {
+		if ((unsigned)sdl_pitch != f.line_length)
+			fprintf(stderr, "asp-fb: MISMATCH - SDL pitch %d but driver "
+				"line_length %u. Rows will land %.2f apart from "
+				"where the hardware reads them.\n",
+				sdl_pitch, f.line_length,
+				sdl_pitch ? (double)f.line_length / (double)sdl_pitch : 0.0);
+		else
+			fprintf(stderr, "asp-fb: pitch agrees at %d (%d bytes/pixel)\n",
+				sdl_pitch, sdl_pxbytes);
+	}
+	close(fd);
+}
