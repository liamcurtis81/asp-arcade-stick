+#define ASP_BTN_OPTIONS 10
+
+/* Input tracing, off unless ASP_INPUT_LOG is set in the environment.
+ *
+ * Written to discover the stick's button numbering and should have come out
+ * once that was known. stderr is line buffered onto the USB card, so with it
+ * on, every press, release and direction change is a synchronous write to
+ * flash, and flash stalls for hundreds of milliseconds while it erases blocks.
+ * That showed up as whole seconds of freeze in a button-heavy game. Turn it
+ * back on for one run when a mapping needs establishing, not for play. */
+static int asp_input_log(void)
+{
