+	f = fopen(path, "r");
+	if (f == NULL) {
+		fprintf(stderr, "asp: no %s, filling the panel\n", path);
+		return;
+	}
+	while (fgets(line, sizeof(line), f) != NULL) {
+		int v, pw, ph;
+		char word[64];
+		if (line[0] == '#' || line[0] == '\n' || line[0] == '\r')
+			continue;
+		if (sscanf(line, "inset_x = %d", &v) == 1 ||
+		    sscanf(line, "inset_x=%d", &v) == 1)
+			asp_inset_x = v;
+		else if (sscanf(line, "inset_y = %d", &v) == 1 ||
+		         sscanf(line, "inset_y=%d", &v) == 1)
+			asp_inset_y = v;
+		else if (sscanf(line, "aspect = %63s", word) == 1 ||
+		         sscanf(line, "aspect=%63s", word) == 1)
+			asp_keep_aspect = (strncmp(word, "fill", 4) != 0);
+		else if (sscanf(line, "calibrate = %d", &v) == 1 ||
+		         sscanf(line, "calibrate=%d", &v) == 1)
