+/* Game Genie (xxxx-xxxx) and Pro Action Replay (8 hex) codes, '+' between
+ * parts. Every switched-on cheat is re-added from scratch, saving the byte it
+ * replaces so switching it off puts the game back. */
+static int asp_cheats_emulator_apply(void)
+{
+	int i, n = 0;
+	S9xDeleteCheats();
+	for (i = 0; i < cht_n; i++) {
+		char buf[1200], *part, *save = NULL;
+		int ok = 1, added = 0;
+		if (!cht[i].on || !cht_usable(i)) continue;
+		snprintf(buf, sizeof(buf), "%s", cht[i].code);
+		for (part = strtok_r(buf, "+ ", &save); part; part = strtok_r(NULL, "+ ", &save)) {
+			uint32 a; uint8 b;
+			if (S9xGameGenieToRaw(part, a, b) == NULL || S9xProActionReplayToRaw(part, a, b) == NULL) {
+				S9xAddCheat(TRUE, TRUE, a, b);
+				added++;
+			} else
+				ok = 0;
+		}
+		if (ok && added) n++;
+	}
+	S9xApplyCheats();
+	return n;
+}
