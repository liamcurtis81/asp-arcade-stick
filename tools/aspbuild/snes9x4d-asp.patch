+/* asp_geom.h - first-frame setup and where on the panel the frame goes.
+ *
+ * Include order is asp_fbout.h, then asp_calib.h, then this. It uses both, and
+ * it reads the configuration variables each emulator declares before them:
+ * asp_inset_x, asp_inset_y, asp_keep_aspect, asp_calibrate, asp_fb_mode, and
+ * the function asp_read_screen_cfg(), which needs a forward declaration above
+ * the includes.
+ *
+ * Two corrections are applied, and they are independent of each other - which
+ * is what several earlier rounds of this work kept conflating:
+ *
+ * Overscan. The panel shows less than the whole framebuffer, so content near
+ * the edges falls off. Drawing into a smaller centred rectangle is the cure.
+ * How much smaller belongs to the display, so it comes from asp_screen.cfg and
+ * can be corrected without a rebuild.
+ *
+ * Aspect. These are all 4:3 systems, and the framebuffer is 16:9, so the frame
+ * has to be fitted rather than stretched to fill.
+ *
+ * But the framebuffer is not the last word on shape. A display that scales
+ * 1280x720 to fill a panel of some other proportion distorts the picture after
+ * it leaves the framebuffer, where nothing here can reach it. On the 1280x1024
+ * 5:4 monitor this was tested against, every frame was coming out 1024/720 =
+ * 1.42x too tall, and fitting a clean 4:3 rectangle in the framebuffer made
+ * that worse rather than better: 960x720 displays as 0.94, while simply
+ * filling the frame displays as 1.25, which is why "stretched" became "tall
+ * and narrow" when the aspect fit was added.
+ *
+ * So panel_aspect says what the display actually is, and the target is solved
+ * for the shape that comes out right after the display has had its way:
+ *
+ *   dw/dh = (4/3) * (framebuffer aspect) / (panel aspect)
+ *
+ * which on a 5:4 panel is 1280x675 - full width, with thin bars top and
+ * bottom - and on a 16:9 panel reduces to the plain 960x720.
+ *
+ * Setting the monitor itself to preserve aspect ratio is the better fix where
+ * the monitor offers it, since it costs no resolution. This is for when it
+ * does not, or is not set that way.
+ */
+
+#ifndef ASP_GEOM_H
+#define ASP_GEOM_H
+
+/* Opens the framebuffer, runs calibration if asked, and clears the screen.
+ * Safe to call every frame; the work happens once. Returns 0 if the
+ * framebuffer could not be opened, in which case the caller should draw
+ * nothing rather than fall back to a path known to be wrong. */
+static int asp_fb_first_frame_setup(void)
+{
+	static int done, ok;
+
+	if (done)
+		return ok;
+	done = 1;
+
+	asp_read_screen_cfg();
+	asp_fb_mode_cfg = asp_fb_mode;
+
+	if (asp_calibrate == 2) {
+		asp_run_square_test();
+		ok = asp_fb_ready;
+	} else if (asp_calibrate) {
+		asp_run_fb_calibration();
+		ok = asp_fb_ready;
+	} else {
+		ok = asp_fb_open();
+	}
+
+	if (!ok) {
+		fprintf(stderr, "asp: no framebuffer output path available; "
+			"drawing nothing rather than writing at a stride known to "
+			"be wrong\n");
+		return 0;
+	}
+
+	asp_fb_clear_all();
+	return 1;
+}
+
+/* Fills in the destination rectangle, and clears the screen whenever that
+ * rectangle moves so the margin never keeps the previous frame's edges. */
+static int last_x, last_y, last_w, last_h = -1;
+
+/* Only the tests use this, to re-solve the target under a different panel. */
+static void asp_reset_target_cache(void) { last_h = -1; }
+
+static void asp_target_rect_fb(int *ox, int *oy, int *dw, int *dh)
+{
+	int availw, availh, w, h;
+
+	availw = asp_fb_w - 2 * asp_inset_x;
+	availh = asp_fb_h - 2 * asp_inset_y;
+	if (availw <= 0 || availh <= 0) {
+		availw = asp_fb_w;
+		availh = asp_fb_h;
+	}
+
+	if (asp_keep_aspect) {
+		/* Target shape, in framebuffer pixels, that comes out as 4:3 once the
+		 * display has scaled the framebuffer onto its own panel:
+		 *   dw/dh = (4/3) * (fb_w/fb_h) / (panel_w/panel_h)
+		 * Kept in integers: num/den = 4 * fb_w * panel_h, 3 * fb_h * panel_w.
+		 */
+		long num = 4L * asp_fb_w * asp_panel_h;
+		long den = 3L * asp_fb_h * asp_panel_w;
+
+		if (num <= 0 || den <= 0) {       /* nonsense config; fall back to 4:3 */
+			num = 4; den = 3;
+		}
+		w = availw;
+		h = (int)((long)w * den / num);
+		if (h > availh) {
+			h = availh;
+			w = (int)((long)h * num / den);
+		}
+	} else {
+		w = availw;
+		h = availh;
+	}
+
+	*dw = w;
+	*dh = h;
+	*ox = asp_inset_x + (availw - w) / 2;
+	*oy = asp_inset_y + (availh - h) / 2;
+
+	if (*ox != last_x || *oy != last_y || w != last_w || h != last_h) {
+		asp_fb_clear();
+		last_x = *ox; last_y = *oy; last_w = w; last_h = h;
+		fprintf(stderr, "asp: drawing into %dx%d at %d,%d "
+			"(framebuffer %dx%d)\n", w, h, *ox, *oy, asp_fb_w, asp_fb_h);
+	}
+}
+
+#endif /* ASP_GEOM_H */
diff --git a/dingux-sdl/asp_manual.h b/dingux-sdl/asp_manual.h
new file mode 100644
index 0000000..7e006f4
--- /dev/null
+++ b/dingux-sdl/asp_manual.h
@@ -0,0 +1,343 @@
+/* asp_manual.h - the game's instruction manual, read in-game on the TV.
+ *
+ * Hold Select + L1 for a second: the game pauses (sound too) and the manual
+ * opens on the page last read. Pages are images in
+ *   <card>/ASPh/hack/manuals/psx/<game>/   (01.jpg, 02.jpg ... in name order)
+ * where <game> is the game's folder under roms/psx, or the file name without
+ * its extension for a game that sits directly in roms/psx.
+ *
+ *   Left / Right, L1 / R1   previous / next page (d-pad pans when zoomed in)
+ *   Up / Down               pan when zoomed in
+ *   Circle (right button)   zoom in      Cross (bottom button)  zoom out
+ *   Start, or Select + L1   back to the game
+ *
+ * Drawn straight into the framebuffer at its own resolution, with an area
+ * filter so small print stays legible, and corrected for the display's pixel
+ * shape the same way the game picture is.
+ *
+ * Shared by the ASP frontends. The includer defines ASP_MAN_SYS (the folder
+ * name under roms/ and manuals/), ASP_MAN_PRESENTER if a presenter thread
+ * owns the screen between frames, and provides
+ *   man_buttons(int *l1, int *r1, int *zin, int *zout, int *start, int *sel)
+ * plus jb/joy/pad_mode/quit_now/audio_ok/bin_dir as the frontends all do. */
+#ifndef ASP_MANUAL_H
+#define ASP_MANUAL_H
+
+#include <dirent.h>
+#ifndef ASP_MAN_SYS
+#define ASP_MAN_SYS "psx"
+#endif
+
+#define STBI_ONLY_JPEG
+#define STBI_ONLY_PNG
+#define STB_IMAGE_IMPLEMENTATION
+#define STBI_NO_HDR
+#define STBI_NO_LINEAR
+#include "stb_image.h"
+
+#define MAN_MAX_PAGES 400
+static char man_dir[700];
+static char *man_page[MAN_MAX_PAGES];
+static int man_pages, man_cur;
+static unsigned char *man_img;          /* current page, RGB */
+static int man_iw, man_ih, man_loaded = -1;
+static int man_zoom;                    /* 0 = whole page, then x1.5, x2, x3 */
+static double man_cx, man_cy;           /* view centre, in page pixels */
+static uint16_t *man_view;              /* composed screen, fb_w x fb_h */
+static uint16_t *man_bg;                /* the paused game, dimmed */
+
+/* Take what is on screen now - the paused game - and dim it to about a third,
+ * so the page sits over it like a booklet held up in front of the TV. Read
+ * once when the manual opens; the framebuffer is slow to read but this is a
+ * single pass. */
+static void man_grab_background(int ox, int oy, int aw, int ah)
+{
+	int x, y;
+	if (man_bg == NULL) man_bg = (uint16_t *)malloc((size_t)aw * ah * 2);
+	if (man_bg == NULL) return;
+	for (y = 0; y < ah; y++) {
+		const unsigned char *row = asp_fb_row(oy + y);
+		uint16_t *o = man_bg + (size_t)y * aw;
+		if (row == NULL || asp_fb_px != 2) { memset(o, 0, (size_t)aw * 2); continue; }
+		{
+			const uint16_t *r = (const uint16_t *)row + ox;
+			for (x = 0; x < aw; x++) {
+				uint16_t p = r[x];
+				o[x] = (uint16_t)(((p >> 2) & 0x39E7) + ((p >> 3) & 0x18E3));
+			}
+		}
+	}
+}
+
+static int man_cmp(const void *a, const void *b)
+{
+	return strcmp(*(char *const *)a, *(char *const *)b);
+}
+
+/* Find the manual for the game being started; quietly nothing if none. */
+static void manual_find(const char *content)
+{
+	char game[300], *p;
+	const char *rp = strcasestr(content, "/roms/" ASP_MAN_SYS "/");
+	DIR *d;
+	struct dirent *e;
+
+	if (rp == NULL) return;
+	rp += strlen("/roms/" ASP_MAN_SYS "/");
+	snprintf(game, sizeof(game), "%s", rp);
+	p = strchr(game, '/');
+	if (p) *p = 0;                                  /* the game's folder */
+	else if ((p = strrchr(game, '.')) != NULL) *p = 0;  /* or its file name */
+
+	snprintf(man_dir, sizeof(man_dir), "%s../../manuals/" ASP_MAN_SYS "/%s", bin_dir, game);
+	d = opendir(man_dir);
+	if (d == NULL) {
+		fprintf(stderr, "asp: no manual (%s)\n", man_dir);
+		return;
+	}
+	while ((e = readdir(d)) != NULL && man_pages < MAN_MAX_PAGES) {
+		const char *x = strrchr(e->d_name, '.');
+		if (e->d_name[0] == '.' || x == NULL) continue;
+		if (strcasecmp(x, ".jpg") && strcasecmp(x, ".jpeg") && strcasecmp(x, ".png")) continue;
+		man_page[man_pages++] = strdup(e->d_name);
+	}
+	closedir(d);
+	qsort(man_page, man_pages, sizeof(man_page[0]), man_cmp);
+	fprintf(stderr, "asp: manual has %d pages (%s)\n", man_pages, man_dir);
+}
+
+static int man_load(int i)
+{
+	char path[1000];
+	int n;
+	if (i == man_loaded && man_img) return 1;
+	if (man_img) { stbi_image_free(man_img); man_img = NULL; }
+	man_loaded = -1;
+	snprintf(path, sizeof(path), "%s/%s", man_dir, man_page[i]);
+	man_img = stbi_load(path, &man_iw, &man_ih, &n, 3);
+	if (man_img == NULL) {
+		fprintf(stderr, "asp: manual page %s unreadable: %s\n", path, stbi_failure_reason());
+		return 0;
+	}
+	man_loaded = i;
+	return 1;
+}
+
+/* Horizontal stretch of one framebuffer pixel relative to a square one: the
+ * framebuffer is shown on the panel at the panel's shape, not its own. */
+static double man_kx(void)
+{
+	double k = ((double)asp_fb_w / asp_fb_h) / ((double)asp_panel_w / asp_panel_h);
+	return (k > 0.2 && k < 5) ? k : 1.0;
+}
+
+/* Page pixels per screen row at the current zoom. */
+static double man_scale(int aw, int ah)
+{
+	static const double zf[] = { 1.0, 1.5, 2.0, 3.0 };
+	double kx = man_kx();
+	double fit_h = (double)ah / man_ih;
+	double fit_w = (double)aw / (man_iw * kx);
+	return (fit_h < fit_w ? fit_h : fit_w) * zf[man_zoom];
+}
+
+static void man_clamp(int aw, int ah)
+{
+	double s = man_scale(aw, ah), kx = man_kx();
+	double hw = aw / (2 * s * kx), hh = ah / (2 * s);   /* half view, in page px */
+	if (hw * 2 >= man_iw) man_cx = man_iw / 2.0;
+	else { if (man_cx < hw) man_cx = hw; if (man_cx > man_iw - hw) man_cx = man_iw - hw; }
+	if (hh * 2 >= man_ih) man_cy = man_ih / 2.0;
+	else { if (man_cy < hh) man_cy = hh; if (man_cy > man_ih - hh) man_cy = man_ih - hh; }
+}
+
+static void man_draw(void)
+{
+	int ox = asp_inset_x, oy = asp_inset_y;
+	int aw = asp_fb_w - 2 * asp_inset_x, ah = asp_fb_h - 2 * asp_inset_y;
+	int x, y;
+	double s, kx, sx_step, sy_step, x0, y0;
+
+	if (aw <= 0 || ah <= 0) { ox = oy = 0; aw = asp_fb_w; ah = asp_fb_h; }
+	if (man_view == NULL) man_view = (uint16_t *)malloc((size_t)aw * ah * 2);
+	if (man_view == NULL) return;
+	if (man_bg) memcpy(man_view, man_bg, (size_t)aw * ah * 2);
+	else memset(man_view, 0, (size_t)aw * ah * 2);
+
+	if (man_load(man_cur)) {
+		man_clamp(aw, ah);
+		s = man_scale(aw, ah);
+		kx = man_kx();
+		sx_step = 1.0 / (s * kx);           /* page px per screen column */
+		sy_step = 1.0 / s;                  /* page px per screen row */
+		x0 = man_cx - aw / 2.0 * sx_step;
+		y0 = man_cy - ah / 2.0 * sy_step;
+		for (y = 0; y < ah; y++) {
+			double fy0 = y0 + y * sy_step, fy1 = fy0 + sy_step;
+			int ya = (int)fy0, yb = (int)fy1;
+			uint16_t *out = man_view + (size_t)y * aw;
+			if (fy1 <= 0 || fy0 >= man_ih) continue;
+			if (ya < 0) ya = 0;
+			if (yb >= man_ih) yb = man_ih - 1;
+			if (yb < ya) yb = ya;
+			for (x = 0; x < aw; x++) {
+				double fx0 = x0 + x * sx_step, fx1 = fx0 + sx_step;
+				int xa = (int)fx0, xb = (int)fx1, i, j;
+				unsigned r = 0, g = 0, b = 0, n = 0;
+				if (fx1 <= 0 || fx0 >= man_iw) continue;
+				if (xa < 0) xa = 0;
+				if (xb >= man_iw) xb = man_iw - 1;
+				if (xb < xa) xb = xa;
+				/* Box filter over the source pixels this one covers;
+				 * plain sampling turns small print to noise at this size. */
+				for (j = ya; j <= yb; j++) {
+					const unsigned char *q = man_img + ((size_t)j * man_iw + xa) * 3;
+					for (i = xa; i <= xb; i++, q += 3) { r += q[0]; g += q[1]; b += q[2]; n++; }
+				}
+				r /= n; g /= n; b /= n;
+				out[x] = (uint16_t)(((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3));
+			}
+		}
+	}
+	/* Where you are in the book: a thin bar along the bottom. */
+	if (man_pages > 1) {
+		int filled = (int)((long)aw * (man_cur + 1) / man_pages);
+		for (y = ah - 4; y < ah; y++)
+			for (x = 0; x < aw; x++)
+				man_view[(size_t)y * aw + x] = x < filled ? 0xFD20 : 0x4208;
+	}
+	asp_fb_present(man_view, aw, ah, aw, ox, oy, aw, ah);
+}
+
+/* Optional off-device script: ASP_MANUAL_SCRIPT, one action per pass. */
+static const char *man_script;
+
+static int man_pressed(int now, int *prev)
+{
+	int hit = now && !*prev;
+	*prev = now;
+	return hit;
+}
+
+/* Runs with the game paused; returns when the player goes back. */
+static void manual_show(void)
+{
+	static int last_page_read;
+	int p_left = 1, p_right = 1, p_up = 1, p_down = 1, p_l = 1, p_r = 1, p_in = 1, p_out = 1, p_start = 1, p_close = 1;
+	int redraw = 1, done = 0, step = 0;
+
+	if (man_pages == 0) return;
+	if (!asp_fb_first_frame_setup()) return;
+
+#ifdef ASP_MAN_PRESENTER
+	/* Let the presenter finish the frame it is on before we take the screen. */
+	for (;;) {
+		int idle;
+		pthread_mutex_lock(&pb_mx);
+		idle = pb_busy < 0 && pb_ready < 0;
+		pthread_mutex_unlock(&pb_mx);
+		if (idle) break;
+		SDL_Delay(2);
+	}
+#endif
+	if (audio_ok) SDL_PauseAudio(1);
+	fprintf(stderr, "asp: manual open at page %d of %d\n", last_page_read + 1, man_pages);
+	man_cur = last_page_read;
+	man_zoom = 0;
+	man_cx = man_cy = 0;
+	{
+		int aw = asp_fb_w - 2 * asp_inset_x, ah = asp_fb_h - 2 * asp_inset_y;
+		int ox = asp_inset_x, oy = asp_inset_y;
+		if (aw <= 0 || ah <= 0) { ox = oy = 0; aw = asp_fb_w; ah = asp_fb_h; }
+		man_grab_background(ox, oy, aw, ah);
+	}
+	if (man_script == NULL) man_script = getenv("ASP_MANUAL_SCRIPT");
+
+	if (man_load(man_cur)) { man_cx = man_iw / 2.0; man_cy = 0; }
+	man_draw();
+	redraw = 0;
+
+	while (!done) {
+		Uint8 *ks, hat = 0;
+		int left, right, up, down, l1, r1, zin, zout, start, close;
+		SDL_Event ev;
+		while (SDL_PollEvent(&ev))
+			if (ev.type == SDL_QUIT) { quit_now = 1; done = 1; }
+		SDL_JoystickUpdate();
+		ks = SDL_GetKeyState(NULL);
+		if (pad_mode && SDL_JoystickNumHats(joy) > 0) hat = SDL_JoystickGetHat(joy, 0);
+		left  = ks[SDLK_LEFT]  || (hat & SDL_HAT_LEFT);
+		right = ks[SDLK_RIGHT] || (hat & SDL_HAT_RIGHT);
+		up    = ks[SDLK_UP]    || (hat & SDL_HAT_UP);
+		down  = ks[SDLK_DOWN]  || (hat & SDL_HAT_DOWN);
+		{
+			int sel;
+			man_buttons(&l1, &r1, &zin, &zout, &start, &sel);
+			close = sel && l1;
+		}
+		if (man_script) {
+			char c = man_script[step / 4];
+			int on = (step % 4) < 2;     /* press for two passes, release for two */
+			left = right = up = down = l1 = r1 = zin = zout = start = close = 0;
+			if (c == 0) { done = 1; break; }
+			if (c == 'x') _exit(0);        /* leave the screen as it is, for a look */
+			if (on) switch (c) {
+				case 'n': r1 = 1; break;     case 'p': l1 = 1; break;
+				case '+': zin = 1; break;    case '-': zout = 1; break;
+				case 'l': left = 1; break;   case 'r': right = 1; break;
+				case 'u': up = 1; break;     case 'd': down = 1; break;
+				case 'q': start = 1; break;
+			}
+			step++;
+		}
+
+		if (man_pressed(start, &p_start) || man_pressed(close, &p_close)) break;
+		if (close) { SDL_Delay(16); continue; }   /* Select+L1 still held from opening */
+
+		{
+			int aw = asp_fb_w - 2 * asp_inset_x, ah = asp_fb_h - 2 * asp_inset_y;
+			double s = man_scale(aw, ah), kx = man_kx();
+			double pan_x = aw / (4 * s * kx), pan_y = ah / (4 * s);
+			int prev = man_cur;
+			if (man_pressed(l1, &p_l) || (man_zoom == 0 && man_pressed(left, &p_left))) {
+				if (man_cur > 0) man_cur--;
+			}
+			if (man_pressed(r1, &p_r) || (man_zoom == 0 && man_pressed(right, &p_right))) {
+				if (man_cur < man_pages - 1) man_cur++;
+			}
+			if (man_cur != prev) {          /* new page: start at its top */
+				man_load(man_cur);
+				man_cx = man_iw / 2.0;
+				man_cy = 0;
+				redraw = 1;
+			}
+			if (man_zoom > 0) {
+				if (man_pressed(left, &p_left))   { man_cx -= pan_x; redraw = 1; }
+				if (man_pressed(right, &p_right)) { man_cx += pan_x; redraw = 1; }
+				if (man_pressed(up, &p_up))       { man_cy -= pan_y; redraw = 1; }
+				if (man_pressed(down, &p_down))   { man_cy += pan_y; redraw = 1; }
+			} else {
+				p_up = up; p_down = down;
+			}
+			if (man_pressed(zin, &p_in) && man_zoom < 3)   { man_zoom++; redraw = 1; }
+			if (man_pressed(zout, &p_out) && man_zoom > 0) { man_zoom--; redraw = 1; }
+		}
+		if (redraw) {
+			man_draw();
+			redraw = 0;
+		}
+		SDL_Delay(16);
+	}
+
+	last_page_read = man_cur;
+	fprintf(stderr, "asp: manual closed at page %d\n", man_cur + 1);
+	if (man_img) { stbi_image_free(man_img); man_img = NULL; man_loaded = -1; }
+	free(man_bg); man_bg = NULL;          /* the next opening takes a fresh picture */
+	/* Hand the screen back: clear it so the margins lose the page, and make
+	 * the next game frame re-solve its rectangle. */
+	asp_fb_clear();
+	asp_reset_target_cache();
+	if (audio_ok) SDL_PauseAudio(0);
+}
+
+#endif
diff --git a/dingux-sdl/asp_p2.h b/dingux-sdl/asp_p2.h
new file mode 100644
index 0000000..d57bf2f
--- /dev/null
+++ b/dingux-sdl/asp_p2.h
@@ -0,0 +1,106 @@
+/* asp_p2.h - two players: the stick and a pad on the adaptor at once.
+ *
+ * With a pad plugged in, SDL only reports the pad (the adaptor, "JJ", 16
+ * buttons). The stick has not gone anywhere: it is the ASP's own keypad,
+ * a Linux input device called "atc260x-adckeypad", and is read here
+ * directly. Its codes, from the arcade build's input log, map onto the same
+ * button numbers SDL gives the stick when it is on its own:
+ *
+ *   KEY_UP/DOWN/LEFT/RIGHT   the lever
+ *   BTN 304..311             buttons 0..7   (A, B, C, greys, D, ...)
+ *   BTN_SELECT 314           8  Select
+ *   BTN_START  315           9  Start
+ *   278                      10 Options
+ *   279                      11 Turbo
+ *
+ * Which player the pad is follows the port it is in. The arcade build's
+ * input log, taken with the adaptor in the 1P port, shows its USB path as
+ * "usb-aotg_hub.0-1.1": that port makes the pad player 1 and the stick
+ * player 2. Any other port (the 2P port) makes the stick player 1 and the
+ * pad player 2.
+ *
+ * Include after SDL and stdio. */
+#ifndef ASP_P2_H
+#define ASP_P2_H
+#include <fcntl.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <linux/input.h>
+
+static int asp_stk_fd = -1;
+static unsigned asp_stk_btn;            /* bit n: stick button n held */
+static unsigned asp_stk_dir;            /* 1 up, 2 down, 4 left, 8 right */
+static int asp_pad_p1;                  /* 1: the pad is in the 1P port */
+
+#define ASP_STK_UP    1
+#define ASP_STK_DOWN  2
+#define ASP_STK_LEFT  4
+#define ASP_STK_RIGHT 8
+
+/* Called once, with the pad SDL found. Returns 1 if the stick can be read
+ * as a second player. */
+static int asp_p2_init(SDL_Joystick *pad)
+{
+	DIR *d;
+	struct dirent *e;
+	const char *padname = pad ? SDL_JoystickName(0) : NULL;
+	if (asp_stk_fd >= 0) return 1;
+	d = opendir("/dev/input");
+	if (d == NULL) { fprintf(stderr, "asp: p2: no /dev/input\n"); return 0; }
+	while ((e = readdir(d)) != NULL) {
+		char path[300], name[128] = "", phys[128] = "";
+		int fd;
+		if (strncmp(e->d_name, "event", 5)) continue;
+		snprintf(path, sizeof(path), "/dev/input/%s", e->d_name);
+		fd = open(path, O_RDONLY | O_NONBLOCK);
+		if (fd < 0) continue;
+		ioctl(fd, EVIOCGNAME(sizeof(name) - 1), name);
+		ioctl(fd, EVIOCGPHYS(sizeof(phys) - 1), phys);
+		if (padname && !strcmp(name, padname)) {
+			asp_pad_p1 = strstr(phys, "-1.1/") != NULL;
+			fprintf(stderr, "asp: p2: pad \"%s\" on %s (%s): %s port\n", name, phys, path,
+				asp_pad_p1 ? "1P" : "2P");
+		}
+		if (asp_stk_fd < 0 && strstr(name, "adckeypad")) {
+			asp_stk_fd = fd;
+			fprintf(stderr, "asp: p2: stick is %s (%s)\n", path, name);
+			continue;
+		}
+		close(fd);
+	}
+	closedir(d);
+	if (asp_stk_fd < 0) fprintf(stderr, "asp: p2: stick keypad not found, one player only\n");
+	else fprintf(stderr, "asp: p2: player 1 is the %s, player 2 the %s\n",
+		asp_pad_p1 ? "pad" : "stick", asp_pad_p1 ? "stick" : "pad");
+	return asp_stk_fd >= 0;
+}
+
+/* Once a frame: take in everything the stick sent since the last call. */
+static void asp_p2_poll(void)
+{
+	struct input_event ev;
+	if (asp_stk_fd < 0) return;
+	while (read(asp_stk_fd, &ev, sizeof(ev)) == (ssize_t)sizeof(ev)) {
+		int bit = -1, dir = 0;
+		if (ev.type != EV_KEY || ev.value == 2) continue;
+		switch (ev.code) {
+		case KEY_UP:    dir = ASP_STK_UP;    break;
+		case KEY_DOWN:  dir = ASP_STK_DOWN;  break;
+		case KEY_LEFT:  dir = ASP_STK_LEFT;  break;
+		case KEY_RIGHT: dir = ASP_STK_RIGHT; break;
+		case 314: bit = 8;  break;
+		case 315: bit = 9;  break;
+		case 278: bit = 10; break;
+		case 279: bit = 11; break;
+		default:
+			if (ev.code >= 304 && ev.code <= 311) bit = ev.code - 304;
+		}
+		if (dir) { if (ev.value) asp_stk_dir |= dir; else asp_stk_dir &= ~dir; }
+		if (bit >= 0) { if (ev.value) asp_stk_btn |= 1u << bit; else asp_stk_btn &= ~(1u << bit); }
+	}
+}
+
+static int asp_stk_jb(int n) { return (asp_stk_btn >> n) & 1; }
+#endif
diff --git a/dingux-sdl/asp_stats.h b/dingux-sdl/asp_stats.h
new file mode 100644
index 0000000..639e467
--- /dev/null
+++ b/dingux-sdl/asp_stats.h
@@ -0,0 +1,105 @@
+/* asp_stats.h - how long each game has been played, and in what order.
+ *
+ * Every console frontend calls asp_stats_begin(system, rom path) once the game
+ * is loaded. At exit the session's seconds are added to
+ *   <card>/ASPh/hack/stats/playtime.txt
+ * one line per game: system<TAB>game<TAB>total seconds<TAB>sessions<TAB>order
+ * where order is a counter that goes up by one every time any game is played
+ * (the stick's clock resets to 2011 on each boot, so dates are no use for
+ * "recently played"; the counter is). The file is rewritten whole through a
+ * temporary file, so an interrupted write leaves the old one intact.
+ *
+ * Header-only, plain C, used from C and C++ frontends. */
+#ifndef ASP_STATS_H
+#define ASP_STATS_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+static char asp_st_sys[16], asp_st_game[256], asp_st_dir[600];
+static struct timespec asp_st_t0;
+static int asp_st_on;
+
+static void asp_stats_end(void)
+{
+	char path[700], tmp[720], line[512];
+	struct timespec t1;
+	long secs, best_order = 0;
+	FILE *in, *out;
+	int found = 0;
+
+	if (!asp_st_on) return;
+	asp_st_on = 0;
+	clock_gettime(CLOCK_MONOTONIC, &t1);
+	secs = (long)(t1.tv_sec - asp_st_t0.tv_sec);
+	if (secs < 5) return;                     /* launched by mistake */
+
+	snprintf(path, sizeof(path), "%s/playtime.txt", asp_st_dir);
+	snprintf(tmp, sizeof(tmp), "%s/playtime.new", asp_st_dir);
+	in = fopen(path, "r");
+	if (in) {                                 /* highest order so far */
+		while (fgets(line, sizeof(line), in)) {
+			char *f[5]; int n = 0; char *p = line;
+			while (n < 5 && (f[n] = strsep(&p, "\t\n")) != NULL) n++;
+			if (n >= 5 && atol(f[4]) > best_order) best_order = atol(f[4]);
+		}
+		rewind(in);
+	}
+	out = fopen(tmp, "w");
+	if (out == NULL) { if (in) fclose(in); return; }
+	if (in) {
+		while (fgets(line, sizeof(line), in)) {
+			char copy[512], *f[5]; int n = 0; char *p = copy;
+			snprintf(copy, sizeof(copy), "%s", line);
+			while (n < 5 && (f[n] = strsep(&p, "\t\n")) != NULL) n++;
+			if (n >= 5 && !strcmp(f[0], asp_st_sys) && !strcmp(f[1], asp_st_game)) {
+				fprintf(out, "%s\t%s\t%ld\t%ld\t%ld\n", asp_st_sys, asp_st_game,
+					atol(f[2]) + secs, atol(f[3]) + 1, best_order + 1);
+				found = 1;
+			} else if (n >= 5)
+				fputs(line, out);
+		}
+		fclose(in);
+	}
+	if (!found)
+		fprintf(out, "%s\t%s\t%ld\t1\t%ld\n", asp_st_sys, asp_st_game, secs, best_order + 1);
+	fflush(out);
+	fsync(fileno(out));
+	fclose(out);
+	rename(tmp, path);
+	fprintf(stderr, "asp: played %ld s this session (%s/%s)\n", secs, asp_st_sys, asp_st_game);
+}
+
+/* exe_dir is the emulator's own folder (…/hack/bin/<sys>/), rom the path the
+ * launcher gave. The game is named by its file, or for a PlayStation game in
+ * its own folder, by the folder - the same names the manuals use. */
+static void asp_stats_begin(const char *exe_dir, const char *sys, const char *rom)
+{
+	const char *b, *r;
+	char *dot;
+	char key[300];
+	snprintf(asp_st_sys, sizeof(asp_st_sys), "%s", sys);
+	snprintf(asp_st_dir, sizeof(asp_st_dir), "%s../../stats", exe_dir);
+	mkdir(asp_st_dir, 0755);
+	r = strstr(rom, "/roms/");
+	if (r && (r = strchr(r + 6, '/')) != NULL) {
+		r++;
+		snprintf(key, sizeof(key), "%s", r);
+		if (strchr(key, '/')) *strchr(key, '/') = 0;     /* game in a folder */
+		else if ((dot = strrchr(key, '.')) != NULL) *dot = 0;
+	} else {
+		b = strrchr(rom, '/');
+		snprintf(key, sizeof(key), "%s", b ? b + 1 : rom);
+		if ((dot = strrchr(key, '.')) != NULL) *dot = 0;
+	}
+	snprintf(asp_st_game, sizeof(asp_st_game), "%s", key);
+	clock_gettime(CLOCK_MONOTONIC, &asp_st_t0);
+	asp_st_on = 1;
+	atexit(asp_stats_end);
+}
+
+#endif
