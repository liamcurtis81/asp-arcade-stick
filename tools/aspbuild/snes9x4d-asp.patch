+#ifdef ASP_BUILD
+/* Where on the panel the emulated frame is drawn.
+ *
+ * Two separate things decide this, and conflating them is what made the
+ * earlier attempts go round in circles:
+ *
+ * Overscan. The framebuffer really is 1280x720 and we really do fill it, but
+ * the panel does not show all of it, so content near the edges falls off and
+ * the picture reads as "stretched beyond the monitor edge". The cure is to
+ * draw into a smaller, centred rectangle. How much smaller is a property of
+ * the display, not something to be guessed at, so it is read from
+ * asp_screen.cfg beside the binary and can be corrected without a rebuild.
+ *
+ * Aspect. The SNES is a 4:3 system. Scaling it to a 16:9 panel stretches it
+ * horizontally by a third whatever the overscan is, which is the other half of
+ * "stretched". So the frame is fitted to 4:3 inside whatever the overscan
+ * leaves, and the slack ends up as side bars rather than distortion.
+ *
+ * Whatever is left over has to be cleared. An earlier build drew the inset
+ * frame but left the margin alone, so the previous full-screen frame stayed
+ * visible around it - that is the stray texture that was showing up in the
+ * border.
+ */
+static int asp_inset_x = 0, asp_inset_y = 0;
+static int asp_keep_aspect = 1;
+static int asp_calibrate;
+/* Which reading of the display's contradictory geometry to trust;
+ * see asp_fbout.h. 0 picks automatically. */
+static int asp_fb_mode;
+/* What the display physically is, so the frame can be pre-shaped to come out
+ * 4:3 after the display scales the framebuffer onto it. 16:9 means the display
+ * matches the framebuffer and nothing needs correcting. */
+static int asp_panel_w = 16, asp_panel_h = 9;
+/* Index into sdlaudio.cpp's Rates[]: 6 is 44100, the rate the ASP's audio
+ * node is wired to, so nothing needs resampling. Overridable from
+ * asp_screen.cfg because 44100 is 2.75x the APU work this fork was tuned
+ * for, and if that proves too much for the SoC, 22050 (index 4) is an exact
+ * halving that SDL upconverts cheaply. */
+int asp_sound_rate_idx = 6;
+#include "asp_fbout.h"
+#include "asp_calib.h"
+#include "asp_geom.h"
+
+static void asp_read_screen_cfg(void)
+{
+	static int done;
+	char path[512], line[256];
+	FILE *f;
+	int n;
+
+	/* Called once before sound init and again before the first blit; the
+	 * second call has nothing to add. */
+	if (done)
+		return;
+	done = 1;
+
+	n = readlink("/proc/self/exe", path, sizeof(path) - 24);
+	if (n <= 0)
+		return;
+	path[n] = 0;
+	while (n > 0 && path[n - 1] != '/')
+		n--;
+	strcpy(path + n, "asp_screen.cfg");
+
+	f = fopen(path, "r");
+	if (f == NULL) {
+		fprintf(stderr, "asp: no %s, filling the panel\n", path);
+		return;
+	}
+	while (fgets(line, sizeof(line), f) != NULL) {
+		int v, pw, ph;
+		char word[64];
+		if (line[0] == '#' || line[0] == '\n' || line[0] == '\r')
+			continue;
+		if (sscanf(line, "inset_x = %d", &v) == 1 ||
+		    sscanf(line, "inset_x=%d", &v) == 1)
+			asp_inset_x = v;
+		else if (sscanf(line, "inset_y = %d", &v) == 1 ||
+		         sscanf(line, "inset_y=%d", &v) == 1)
+			asp_inset_y = v;
+		else if (sscanf(line, "aspect = %63s", word) == 1 ||
+		         sscanf(line, "aspect=%63s", word) == 1)
+			asp_keep_aspect = (strncmp(word, "fill", 4) != 0);
+		else if (sscanf(line, "calibrate = %d", &v) == 1 ||
+		         sscanf(line, "calibrate=%d", &v) == 1)
+			asp_calibrate = v;
+		else if (sscanf(line, "fb_mode = %d", &v) == 1 ||
+		         sscanf(line, "fb_mode=%d", &v) == 1)
+			asp_fb_mode = v;
+		else if (sscanf(line, "panel_aspect = %d:%d", &pw, &ph) == 2 ||
+		         sscanf(line, "panel_aspect=%d:%d", &pw, &ph) == 2) {
+			if (pw > 0 && ph > 0) { asp_panel_w = pw; asp_panel_h = ph; }
+		}
+		else if (sscanf(line, "sound_rate = %d", &v) == 1 ||
+		         sscanf(line, "sound_rate=%d", &v) == 1) {
+			static const int rates[8] =
+				{ 0, 8192, 11025, 16000, 22050, 32000, 44100, 48000 };
+			int i, best = 6, bestd = -1;
+			for (i = 1; i < 8; i++) {
+				int d = v > rates[i] ? v - rates[i] : rates[i] - v;
+				if (bestd < 0 || d < bestd) { bestd = d; best = i; }
+			}
+			asp_sound_rate_idx = best;
+		}
+	}
+	fclose(f);
+
+	if (asp_inset_x < 0) asp_inset_x = 0;
+	if (asp_inset_y < 0) asp_inset_y = 0;
+	if (asp_inset_x > 320) asp_inset_x = 320;
+	if (asp_inset_y > 180) asp_inset_y = 180;
+
+	fprintf(stderr, "asp: %s -> inset_x=%d inset_y=%d aspect=%s calibrate=%d\n",
+		path, asp_inset_x, asp_inset_y,
+		asp_keep_aspect ? "keep" : "fill", asp_calibrate);
+	fprintf(stderr, "asp: fb_mode=%d panel_aspect=%d:%d\n",
+		asp_fb_mode, asp_panel_w, asp_panel_h);
+	fprintf(stderr, "asp: sound rate index %d\n", asp_sound_rate_idx);
+}
