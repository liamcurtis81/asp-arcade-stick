+#ifdef ASP_BUILD
+char asp_save_dir[512];
+
+/* Saves go to the directory the firmware passes as argv[2] (normally
+ * /mnt/data/save). Without this snes9x would use $HOME/.snes96_snapshots,
+ * and $HOME is not set to anything writable on this device. */
+static const char *asp_get_save_dir(void)
+{
+	char path[512];
+	int n;
+	if (asp_save_dir[0])
+		return asp_save_dir;
+	n = readlink("/proc/self/exe", path, sizeof(path) - 1);
+	if (n <= 0)
+		return ".";
+	path[n] = 0;
+	while (n > 0 && path[n - 1] != '/') n--;
+	path[n ? n - 1 : 0] = 0;
+	strncpy(asp_save_dir, path, sizeof(asp_save_dir) - 1);
+	return asp_save_dir;
+}
+
+/* The firmware's log.asp.txt is tiny and rewritten every launch, so keep our
+ * own next to the binary. Also note the firmware invokes emulators as
+ *   <emu> "<rom>" /mnt/data/save
+ * so there is always a trailing argument that is not a ROM. */
+static void asp_open_log(void)
+{
+	char path[512];
+	int n = readlink("/proc/self/exe", path, sizeof(path) - 16);
+	if (n <= 0) return;
+	path[n] = 0;
+	while (n > 0 && path[n - 1] != '/') n--;
+	strcpy(path + n, "sfc_log.txt");
+	/* Append rather than truncate, with a cap, and mark each launch. A
+	 * truncating open loses the evidence for any crash as soon as the next
+	 * game is started, which is how one crash report here went unexplained:
+	 * by the time the card could be read, a later launch had overwritten it. */
+	{
+		struct stat lst;
+		const char *mode = "a";
+		if (stat(path, &lst) == 0 && lst.st_size > 512 * 1024)
+			mode = "w";
+		if (freopen(path, mode, stderr) == NULL) return;
+	}
+	setvbuf(stderr, NULL, _IOLBF, 0);
+	dup2(fileno(stderr), fileno(stdout));
+	setvbuf(stdout, NULL, _IOLBF, 0);
+}
+#endif
