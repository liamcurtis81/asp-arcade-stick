+#define STBI_VERSION 1
+
+enum
+{
+   STBI_default = 0, // only used for desired_channels
+
+   STBI_grey       = 1,
+   STBI_grey_alpha = 2,
+   STBI_rgb        = 3,
+   STBI_rgb_alpha  = 4
+};
+
+enum
+{
+   STBI_type_unsupported = 0, // image type
+
+   STBI_type_jpeg,
+   STBI_type_png,
+   STBI_type_gif,
+   STBI_type_bmp,
+   STBI_type_psd,
+   STBI_type_pnm,
+   STBI_type_hdr,
+   STBI_type_tga,
+};
