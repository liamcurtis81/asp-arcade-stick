+			 * I/O PLD and default NVRAM, BRF_NODUMP marks ROMs nobody has
+			 * dumped. Without them a check reports 49 broken romsets when
+			 * most of them run perfectly. */
+			printf("%s\t%s\t%s\t%u\t%08x\t%08x\n",
+				name, parent ? parent : "", rn,
+				(unsigned)ri.nLen, (unsigned)ri.nCrc, (unsigned)ri.nType);
+		}
+	}
+	BurnLibExit();
+}
