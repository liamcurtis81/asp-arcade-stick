+					asp_aud_segs, seg_ms, ring_ms,
+					asp_aud_dev_samples, dev_ms, ring_ms + dev_ms);
+			}
+		}
+
+		{
+			extern void asp_fb_present_split(double *, double *,
+				unsigned int *, unsigned int *, unsigned int *);
+			double sc = 0.0, cp = 0.0;
+			unsigned int rs = 0, rc = 0, nf = 0;
+			asp_fb_present_split(&sc, &cp, &rs, &rc, &nf);
+			if (nf) {
+				fprintf(f, "----- present split: scale %.2f ms (%u rows), "
+					"framebuffer write %.2f ms (%u rows), over %u frames "
+					"-----\n", sc, rs, cp, rc, nf);
+			}
+		}
+
+		// Konami draw breakdown. Only non-zero on the Konami boards, so the
+		// line simply does not appear for CPS1/CPS2 - which is the point, it
+		// shows whether the expensive stage is the sprite mixer or the
+		// per-pixel composite.
+		{
+			extern unsigned long long asp_t_kclear, asp_t_kblend, asp_t_kmixer;
+			extern unsigned int asp_n_kclear, asp_n_kblend, asp_n_kmixer;
+			extern unsigned long long asp_t_ksprite, asp_t_ktile;
+			extern unsigned int asp_n_ksprite, asp_n_ktile;
+			if (asp_n_kblend) {
+				fprintf(f, "----- konami draw: clear %.2f ms (n=%u), "
+					"mixer %.2f ms (n=%u), blend-copy %.2f ms (n=%u); "
+					"total %.2f ms per drawn frame -----\n",
+					asp_t_kclear / 1e6 / (asp_n_kclear ? asp_n_kclear : 1),
+					asp_n_kclear,
+					asp_t_kmixer / 1e6 / (asp_n_kmixer ? asp_n_kmixer : 1),
+					asp_n_kmixer,
+					asp_t_kblend / 1e6 / asp_n_kblend, asp_n_kblend,
+					(asp_t_kclear + asp_t_kmixer + asp_t_kblend)
+						/ 1e6 / asp_n_kblend);
