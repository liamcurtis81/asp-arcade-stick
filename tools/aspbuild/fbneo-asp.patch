+extern void k053247_draw_single_sprite_gxcore(UINT8 *,UINT8 *gx_shdzbuf, INT32 code, UINT16 *gx_spriteram, INT32 offs,
+		INT32 color, INT32 alpha, INT32 drawmode, INT32 zcode, INT32 pri,
