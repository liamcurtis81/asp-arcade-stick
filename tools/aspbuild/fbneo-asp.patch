+// fbneo.ini lives in the launcher's working directory, /mnt/data/usb, on the
+// device's internal storage - not on the card, so it cannot be edited without
+// the device. This reads an optional "key value" file from the card instead,
+// so a tuning change costs one text edit rather than a 27 MB redeploy.
+extern int bAlwaysDrawFrames;
+extern int asp_draw_every_n;
+extern int asp_draw_guard;
+extern int asp_fb_profile;
+extern int asp_aud_segments;
