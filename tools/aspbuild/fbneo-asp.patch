+#ifdef BUILD_ASP
+// Sub-stage timers for the 5.56 ms mixer. The loop dispatches to exactly two
+// things - one sprite at a time, or a tilemap layer - so timing those two and
+// counting the sprites attributes the whole of it. Twice now I have reasoned
+// about where a cost lives and been wrong; this is the alternative.
+#include <time.h>
+unsigned long long asp_t_ksprite = 0, asp_t_ktile = 0;
+unsigned int asp_n_ksprite = 0, asp_n_ktile = 0;
+static inline unsigned long long asp_gx_ns(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (unsigned long long)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+#endif
