+						(double)asp_aud_dev_freq / asp_aud_want_rate);
+				}
+				fprintf(f, "----- audio latency: %d Hz asked / %d Hz device, "
+					"%d samples/segment, %d segments of %.1f ms "
+					"= %.0f ms queued in the ring, plus a %d-sample device "
+					"buffer = %.1f ms; picture leads sound by about %.0f ms "
+					"-----\n",
