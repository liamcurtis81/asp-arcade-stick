+		fprintf(f, "----- audio catch-up batch sizes:");
+		for (int i = 1; i <= 8; i++) {
+			if (asp_batch_hist[i]) fprintf(f, " %d:%u", i, asp_batch_hist[i]);
+		}
+		// A batch at nAudSegCount-1 is the fill pointer as far behind the play
+		// pointer as it can get. On a 6-segment ring that is rare and means
+		// trouble (76 of them in v13, which was audibly booming; 0 in v15). On a
+		// 4-segment ring the maximum backlog IS 3, so the top bucket is the
+		// ordinary top of the distribution: v16 logged 1795 of 5254 and called
+		// them all starvation. Reporting the share, and only calling it starved
+		// when the ring is deep enough for the limit to be exceptional, stops the
+		// metric misleading the next person to read it.
+		unsigned int nbatch = 0;
+		for (int i = 1; i <= 8; i++) nbatch += asp_batch_hist[i];
