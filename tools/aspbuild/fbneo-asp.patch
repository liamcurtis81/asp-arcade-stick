+static void asp_tuning_load(void)
+{
+	static const char *paths[] = {
+		"/mnt/hdisk/ASPh/hack/bin/fba/asp_tuning.txt",
+		"/mnt/udisk/ASPh/hack/bin/fba/asp_tuning.txt",
+		NULL
+	};
+	FILE *f = NULL;
+	for (int i = 0; paths[i] && !f; i++) f = fopen(paths[i], "r");
+	if (!f) {
+		fprintf(stderr, "asp: no asp_tuning.txt, using built-in defaults\n");
+		return;
+	}
+
+	char line[256];
+	while (fgets(line, sizeof(line), f)) {
+		char key[64];
+		int value;
+		if (line[0] == '#' || line[0] == '\n' || line[0] == '\r') continue;
+		if (sscanf(line, "%63s %d", key, &value) != 2) continue;
+
+		if (strcmp(key, "always_draw_frames") == 0) {
+			bAlwaysDrawFrames = value;
+		} else if (strcmp(key, "draw_every_n") == 0) {
+			asp_draw_every_n = value;
+		} else if (strcmp(key, "draw_guard") == 0) {
+			asp_draw_guard = value;      // accepted, no longer consulted
+		} else if (strcmp(key, "profile_present") == 0) {
+			asp_fb_profile = value;
+		} else if (strcmp(key, "audio_segments") == 0) {
+			asp_aud_segments = value;
+		} else if (strcmp(key, "draw_lead") == 0) {
+			asp_draw_lead = value;
+		} else if (strcmp(key, "audio_rate") == 0) {
+			asp_aud_rate_override = value;
+		} else if (strcmp(key, "device_samples") == 0) {
+			asp_aud_device_samples = value;
+		} else if (strcmp(key, "hash_frames") == 0) {
+			asp_hash_frames = value;
+		} else {
+			fprintf(stderr, "asp: tuning: unknown key \"%s\", ignored\n", key);
+			continue;
+		}
+		fprintf(stderr, "asp: tuning: %s = %d\n", key, value);
+	}
+	fclose(f);
+}
