+	setvbuf(stderr, NULL, _IOLBF, 0);
+}
+
+// A crash and a failed allocation both look identical on this device - black
+// screen, straight back to the launcher. This tells them apart by name.
+static void asp_fatal_signal(int sig, siginfo_t *si, void *)
+{
+	static const char *n = NULL;
+	switch (sig) {
+	case SIGSEGV: n = "SIGSEGV (bad memory access)"; break;
+	case SIGBUS:  n = "SIGBUS (unaligned or invalid access)"; break;
+	case SIGILL:  n = "SIGILL (illegal instruction)"; break;
+	case SIGFPE:  n = "SIGFPE"; break;
+	case SIGABRT: n = "SIGABRT (abort, often a failed assertion)"; break;
+	default:      n = "signal"; break;
+	}
+
+	// Write with the raw fd: the crash may have come from inside malloc, and
+	// fprintf on a corrupt heap would just hang or fault again.
+	char buf[160];
+	int len = snprintf(buf, sizeof(buf),
+		"\n*** CRASH: %s at %p ***\n", n, si ? si->si_addr : NULL);
+	if (len > 0) {
+		ssize_t ignored = write(STDERR_FILENO, buf, (size_t)len);
+		(void)ignored;
+	}
+
+	signal(sig, SIG_DFL);
+	raise(sig);
+}
+
+static void asp_install_crash_handler(void)
+{
+	struct sigaction sa;
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_sigaction = asp_fatal_signal;
+	sa.sa_flags = SA_SIGINFO | SA_RESETHAND;
+	sigemptyset(&sa.sa_mask);
+
+	sigaction(SIGSEGV, &sa, NULL);
+	sigaction(SIGBUS,  &sa, NULL);
+	sigaction(SIGILL,  &sa, NULL);
+	sigaction(SIGFPE,  &sa, NULL);
+	sigaction(SIGABRT, &sa, NULL);
+}
+
+static void asp_log_close(void)
+{
+	if (!asp_log) return;
+
+	fprintf(asp_log, "----- startup done, logging off -----\n");
+	fflush(asp_log);
+
+	// Both streams go nowhere from here, so the emulation loop cannot write
+	// to the card no matter how chatty a driver is.
+	int devnull = open("/dev/null", O_WRONLY);
+	if (devnull >= 0) {
+		dup2(devnull, STDOUT_FILENO);
+		dup2(devnull, STDERR_FILENO);
+		close(devnull);
+	}
+	fclose(asp_log);
+	asp_log = NULL;
+}
