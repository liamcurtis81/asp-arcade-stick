+			gaps ? (double)gapsum / gaps : 0.0, asp_draw_guard);
+
+		{
+			extern int asp_aud_rate, asp_aud_seglen, asp_aud_segs;
+			extern int asp_aud_dev_samples, asp_aud_dev_size, asp_aud_dev_freq;
+			extern int asp_aud_want_rate;
+			if (asp_aud_rate > 0 && asp_aud_seglen > 0) {
