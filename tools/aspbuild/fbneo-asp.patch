+				// Omitting it is why 22050 took two runs to diagnose: the
+				// device almost certainly refused it and played 22 kHz data at
+				// 44 kHz, which is the high-pitched speech, the clashing and
+				// the stalling all at once.
+				if (asp_aud_dev_freq && asp_aud_want_rate
+						&& asp_aud_dev_freq != asp_aud_want_rate) {
+					fprintf(f, "----- AUDIO RATE MISMATCH: asked the device "
+						"for %d Hz, it gave %d Hz. Sound will play at %.2fx "
+						"pitch and the loop will stall on it. -----\n",
