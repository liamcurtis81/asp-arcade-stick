+			(limit >= 5 && share > 1.0) ? " = AUDIO STARVED"
+				: (limit < 5 ? " (shallow ring: the limit is also the normal"
+					" maximum, so this is not by itself starvation)" : ""),
+			bAlwaysDrawFrames ? ", OVERRIDDEN: drawing every frame" : "");
