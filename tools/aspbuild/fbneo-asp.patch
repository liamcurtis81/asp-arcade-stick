+		unsigned int at_limit = asp_batch_hist[limit > 8 ? 8 : limit];
+		double share = nbatch ? 100.0 * at_limit / nbatch : 0.0;
+		fprintf(f, " of %d segments; %u of %u batches (%.0f%%) at the %d-segment"
+			" limit%s%s) -----\n",
