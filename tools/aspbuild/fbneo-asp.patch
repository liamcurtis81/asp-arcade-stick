+static void asp_reapply_rom_path(void)
+{
+	if (asp_rom_dir[0] == '\0') return;
+
+	snprintf(szAppRomPaths[0], MAX_PATH, "%s", asp_rom_dir);
+
+	/* Slot 1 is the card's shared romset directory, which is where the BIOS
+	 * sets live: neogeo.zip and pgm.zip are both in ASPh/roms/ while the
+	 * games that need them sit under ASPh/hack/roms/fba/<page>/. FBNeo
+	 * searches every slot, so adding it is what lets the eight PGM titles -
+	 * Knights of Valour, Oriental Legend, Martial Masters, The Killing
+	 * Blade, The Gladiator, S.V.G., Demon Front, Knights of Valour 2 - find
+	 * their system BIOS. They were not missing a download; the emulator was
+	 * only ever looking in one folder. */
+	snprintf(szAppRomPaths[1], MAX_PATH, "%s", "/mnt/hdisk/ASPh/roms/");
+	snprintf(szAppRomPaths[2], MAX_PATH, "%s", "/mnt/udisk/ASPh/roms/");
+
+	// The saved config also restores whatever directories were in the other
+	// nine slots, which belong to another game. Leaving them costs a pointless
+	// search through paths that cannot hold this ROM, and risks loading a
+	// same-named set from the wrong folder. Slot 1 keeps FBNeo's own relative
+	// "roms/" default.
+	for (int i = 3; i < DIRS_MAX; i++) {
+		szAppRomPaths[i][0] = '\0';
+	}
+
+	fprintf(stderr, "asp: rom paths: \"%s\", \"%s\", \"%s\"\n",
+		szAppRomPaths[0], szAppRomPaths[1], szAppRomPaths[2]);
+}
+
+static const char *asp_setup_paths(const char *arg, const char *savedir)
+{
+	const char *slash = strrchr(arg, '/');
+	const char *base  = slash ? slash + 1 : arg;
+
+	if (slash) {
+		size_t n = (size_t)(slash - arg) + 1;		// keep the trailing slash
+		if (n >= MAX_PATH) n = MAX_PATH - 1;
+		memcpy(szAppRomPaths[0], arg, n);
+		szAppRomPaths[0][n] = '\0';
+		snprintf(asp_rom_dir, sizeof(asp_rom_dir), "%s", szAppRomPaths[0]);
+	}
+
+	snprintf(asp_short_name, sizeof(asp_short_name), "%s", base);
+	char *dot = strrchr(asp_short_name, '.');
+	if (dot && (!strcmp(dot, ".zip") || !strcmp(dot, ".ZIP"))) *dot = '\0';
+
+	if (savedir && *savedir && *savedir == '/') {
+		if (chdir(savedir) != 0) {
+			fprintf(stderr, "asp: could not chdir to \"%s\", "
+				"nvram and config will land next to the binary\n", savedir);
+		}
+	}
+
+	fprintf(stderr, "asp: rom \"%s\" in \"%s\", working dir \"%s\"\n",
+		asp_short_name, szAppRomPaths[0], savedir ? savedir : "(unchanged)");
+
+	return asp_short_name;
+}
