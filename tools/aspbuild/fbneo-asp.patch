+#ifdef BUILD_ASP
+// The ASP's launcher invokes an emulator as
+//     <emu> "/mnt/hdisk/asph/hack/roms/fba/brawl/metamrph.zip" /mnt/data/save
+// whereas FBNeo's frontend wants a bare short name plus its own ROM search
+// path. Split the argument here rather than ask the launcher to change, which
+// is what every other emulator on this device had to do too.
+//
+// The second argument is used as the working directory. That matters for more
+// than tidiness: nvram and config otherwise land next to the binary on the USB
+// card, and writes to that card during play are what corrupted it twice.
+// /mnt/data is internal storage, so moving them there takes the card out of
+// the write path entirely.
+static char asp_short_name[64];
+
+// Startup logging.
+//
+// There is no console on this device, so a game that fails to initialise just
+// shows a black screen and drops back to the launcher with no clue as to why.
+// This captures stdout and stderr to a file on the card for the duration of
+// startup only, and then sends both to /dev/null before the emulation loop
+// begins - so there is a diagnostic when loading fails and not a single write
+// to the card while a game is actually running. Per-frame writes to the card
+// are what corrupted it twice; a dozen lines per launch is not that.
+static FILE *asp_log = NULL;
+
+static void asp_log_open(const char *romname)
+{
+	static const char *paths[] = {
+		"/mnt/hdisk/ASPh/hack/bin/fba/fba_emu.log",
+		"/mnt/udisk/ASPh/hack/bin/fba/fba_emu.log",
+		NULL
+	};
+
+	for (int i = 0; paths[i] && !asp_log; i++) {
+		asp_log = fopen(paths[i], "a");
+	}
+	if (!asp_log) return;
+
+	setvbuf(asp_log, NULL, _IOLBF, 0);
+	fprintf(asp_log, "\n===== launch: %s =====\n", romname ? romname : "?");
+
+	// What memory is actually free matters here: the device has 262MB and
+	// this binary is 35MB, so a driver that wants a large decode buffer can
+	// fail on allocation alone. Recording it before and after init says
+	// whether that is what happened.
+	FILE *mi = fopen("/proc/meminfo", "r");
+	if (mi) {
+		char l[128];
+		while (fgets(l, sizeof(l), mi)) {
+			if (!strncmp(l, "MemTotal:", 9) || !strncmp(l, "MemFree:", 8)
+				|| !strncmp(l, "MemAvailable:", 13)) {
